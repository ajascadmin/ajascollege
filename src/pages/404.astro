---
/**
 * Not found. A bare host 404 is the worst page on any institutional site —
 * the most common way to land here is an old bookmark or a printed circular
 * whose URL has changed, so the page offers search and the sections people
 * are actually looking for rather than an apology.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const routes = [
  { label: "Admissions", href: "/admission/", note: "FYUGP & PG intake 2026–27" },
  { label: "Programmes", href: "/programmes/", note: "UG Honours and Master's degrees" },
  { label: "Departments", href: "/departments/", note: "Twelve teaching departments" },
  { label: "Notices & downloads", href: "/notices/", note: "Circulars and statutory documents" },
  { label: "Fees & prospectus", href: "/fees/", note: "Fee structure and the prospectus" },
  { label: "Faculty", href: "/faculties/", note: "Teaching staff directory" },
  { label: "Examinations", href: "/examinations/", note: "Internal exams and results" },
  { label: "Contact", href: "/contact/", note: "Campus address and phone" },
];
---

<BaseLayout
  title="Page not found"
  description="The page you asked for is not on this site. Search, or start from one of the main sections."
  pageTitle="Page not found"
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Page not found" }]}
>
  <div class="nf">
    <div class="nf-inner">
      <div class="nf-head">
        <p class="nf-code">Error 404</p>
        <h2>We couldn’t find that page</h2>
        <p class="nf-lede">
          The address may have changed, or the document may have been replaced by a newer
          version. Search the site, or pick up from one of the sections below.
        </p>
        <button class="nf-search" type="button" data-ajn-search>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          Search the site
        </button>
      </div>

      <ul class="nf-grid">
        {
          routes.map((r) => (
            <li>
              <a href={r.href}>
                <span class="nf-label">{r.label}</span>
                <span class="nf-note">{r.note}</span>
                <svg class="nf-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .nf {
    background: #fff;
    padding: 34px 0 60px;
  }
  .nf-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3.4vw, 56px);
  }
  .nf-head {
    max-width: 62ch;
    padding-bottom: 28px;
    margin-bottom: 34px;
    border-bottom: 2px solid #17304f;
  }
  .nf-code {
    margin: 0 0 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9b3440;
  }
  .nf-head h2 {
    margin: 0 0 14px;
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 2.8vw, 2.5rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #17304f;
  }
  .nf-lede {
    margin: 0 0 22px;
    font-size: 1.05rem;
    line-height: 1.7;
    color: #56677e;
  }
  .nf-search {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 20px;
    border: 1px solid #d9e1ec;
    border-radius: 0;
    background: #fff;
    font: inherit;
    font-size: 14.5px;
    font-weight: 600;
    color: #17304f;
    cursor: pointer;
    transition: border-color 0.18s ease, background 0.18s ease;
  }
  .nf-search:hover {
    border-color: #17304f;
    background: #f4f7fb;
  }
  .nf-search svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .nf-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: #dde4ed;
    border: 1px solid #dde4ed;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  @media (max-width: 1099px) {
    .nf-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 559px) {
    .nf-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .nf-grid a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: 100%;
    padding: 18px 18px 16px;
    background: #fff;
    text-decoration: none;
    color: inherit;
    transition: background 0.18s ease;
  }
  .nf-grid a:hover {
    background: #f7f9fc;
  }
  .nf-label {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 600;
    color: #17304f;
  }
  .nf-grid a:hover .nf-label {
    color: #ff5f60;
  }
  .nf-note {
    font-size: 12.5px;
    line-height: 1.5;
    color: #7b8a9e;
  }
  .nf-arrow {
    width: 15px;
    height: 15px;
    margin-top: 10px;
    fill: none;
    stroke: #c3cedd;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.18s ease, transform 0.18s ease;
  }
  .nf-grid a:hover .nf-arrow {
    stroke: #ff5f60;
    transform: translateX(3px);
  }
</style>
