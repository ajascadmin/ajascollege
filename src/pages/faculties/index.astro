---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CmsImage from "../../components/CmsImage.astro";
import { getListings } from "../../lib/site";

const faculty = (await getCollection("faculty", ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const L = (await getListings())?.faculties ?? {
  title: "Faculties",
  description: "Teaching faculty at Al Jamia Arts & Science College.",
  intro: "Scholars and practitioners across arts, science, commerce and computing — mentoring students beyond the syllabus.",
};
---

<BaseLayout title={L.title} description={L.description} pageTitle={L.title}>
  <div class="flat-team blog-single content-blog">
    <div class="container">
      <p class="listing-intro">{L.intro}</p>
      <div class="row">
        {
          faculty.map((f) => (
            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12">
              <a class="ajas-faculty-card" href={f.data.permalink}>
                <div class="ajas-faculty-photo">
                  {f.data.image ? (
                    <CmsImage
                      src={f.data.image}
                      alt={f.data.title}
                      preset="avatar"
                      fit="cover"
                      width={400}
                    />
                  ) : (
                    <div class="ajas-faculty-placeholder" />
                  )}
                </div>
                <div class="ajas-faculty-body">
                  <h3>{f.data.name || f.data.title}</h3>
                  {f.data.role && <p class="role">{f.data.role}</p>}
                  {f.data.credentials && <p class="cred">{f.data.credentials}</p>}
                </div>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .listing-intro {
    max-width: 40rem;
    margin: 0 0 1.75rem;
    color: #5c6578;
    font-size: 1.05rem;
    line-height: 1.55;
  }
  .ajas-faculty-card {
    display: block;
    margin-bottom: 28px;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 6px 22px rgba(24, 50, 81, 0.08);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .ajas-faculty-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(24, 50, 81, 0.14);
  }
  .ajas-faculty-photo img,
  .ajas-faculty-placeholder {
    width: 100%;
    height: 220px;
    object-fit: cover;
    background: #e8eef4;
    display: block;
  }
  .ajas-faculty-body {
    padding: 14px 14px 16px;
  }
  .ajas-faculty-body h3 {
    margin: 0 0 4px;
    font-size: 1rem;
    color: #183251;
    font-weight: 600;
    line-height: 1.3;
  }
  .ajas-faculty-body .role {
    margin: 0;
    font-size: 0.85rem;
    color: #3f4c99;
    font-weight: 500;
  }
  .ajas-faculty-body .cred {
    margin: 4px 0 0;
    font-size: 0.8rem;
    color: #64748b;
  }
</style>
