---
import { render } from "astro:content";
import { marked } from "marked";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleShell from "../components/ArticleShell.astro";
import EntityArticle from "../components/EntityArticle.astro";
import SmartPage from "../components/layouts/SmartPage.astro";
import CmsImage from "../components/CmsImage.astro";
import AttachmentList from "../components/AttachmentList.astro";
import GallerySection from "../components/GallerySection.astro";
import PeopleGrid from "../components/PeopleGrid.astro";
import MenuGrid from "../components/MenuGrid.astro";
import VideoSection from "../components/VideoSection.astro";
import { optimizeHtmlImages } from "../lib/cmsImage";
import {
  getAllEntries,
  normalizePermalink,
  routeFromPermalink,
  type AnyEntry,
} from "../lib/content";

export async function getStaticPaths() {
  const all = await getAllEntries();
  return all
    .filter((e) => normalizePermalink(e.data.permalink) !== "/")
    .map((entry) => {
      const route = routeFromPermalink(entry.data.permalink);
      const slug = route.replace(/^\//, "");
      return {
        params: { slug },
        props: { entry },
      };
    });
}

interface Props {
  entry: AnyEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const crumbs: { label: string; href?: string }[] = [{ label: "Home", href: "/" }];
const perm = normalizePermalink(entry.data.permalink);
const collection = entry.collection;
const t = "type" in entry.data ? (entry.data as { type?: string }).type : "page";
const isProfile = collection === "faculty" || t === "profile";
const isNews = collection === "news";
const isEvent = collection === "events";
const isEntity = isNews || isEvent;
// Structured info pages (not listings, not pure HTML leftovers)
const isSmartPage =
  collection === "pages" &&
  !isProfile &&
  t !== "listing" &&
  t !== "home" &&
  typeof (entry as { body?: string }).body === "string";

const body = ((entry as { body?: string }).body || "").trim();

const image = "image" in entry.data ? entry.data.image : undefined;
const role = "role" in entry.data ? entry.data.role : undefined;
const credentials = "credentials" in entry.data ? entry.data.credentials : undefined;
const displayName =
  "name" in entry.data && entry.data.name ? String(entry.data.name) : entry.data.title;
const date = "date" in entry.data ? entry.data.date : undefined;
const attachments =
  "attachments" in entry.data ? entry.data.attachments : undefined;
const gallery = "gallery" in entry.data ? entry.data.gallery : undefined;
const people = "people" in entry.data ? entry.data.people : undefined;
const menuItems = "menu_items" in entry.data ? entry.data.menu_items : undefined;
const videos = "videos" in entry.data ? entry.data.videos : undefined;

/** Markdown/HTML body with CMS images rewritten to optimized webp */
const bodyHtmlRaw = body
  ? ((await marked.parse(body, { async: false })) as string)
  : "";
const bodyHtml = bodyHtmlRaw ? await optimizeHtmlImages(bodyHtmlRaw, "inline") : "";

if (isNews) {
  crumbs.push({ label: "News", href: "/college-news/" });
  crumbs.push({ label: entry.data.title });
} else if (isEvent) {
  crumbs.push({ label: "Events", href: "/event/" });
  crumbs.push({ label: entry.data.title });
} else if (perm.startsWith("/faculties/") && perm !== "/faculties/") {
  crumbs.push({ label: "Faculties", href: "/faculties/" });
  crumbs.push({ label: entry.data.title });
} else if (perm.startsWith("/departments/") && perm !== "/departments/") {
  crumbs.push({ label: "Departments", href: "/departments/" });
  crumbs.push({ label: entry.data.title });
} else if (perm.startsWith("/labs/") && perm !== "/labs/") {
  crumbs.push({ label: "Labs", href: "/labs/" });
  crumbs.push({ label: entry.data.title });
} else if (perm.startsWith("/clubs--cells/") && perm !== "/clubs--cells/") {
  crumbs.push({ label: "Clubs & Cells", href: "/clubs--cells/" });
  crumbs.push({ label: entry.data.title });
} else {
  crumbs.push({ label: entry.data.title });
}
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  variant="inner"
  pageTitle={entry.data.title}
  breadcrumbs={crumbs}
>
  {
    isEntity ? (
      <EntityArticle
        kind={isNews ? "news" : "event"}
        title={entry.data.title}
        date={date as Date | undefined}
        image={image}
        backHref={isNews ? "/college-news/" : "/event/"}
        backLabel={isNews ? "All news" : "All events"}
        bodyHtml={bodyHtml}
        videos={videos}
      />
    ) : isProfile ? (
      <div class="ajas-profile-wrap">
        <article class="ajas-profile-card">
          <div class="ajas-profile">
            {image && (
              <div class="ajas-profile-photo">
                <CmsImage
                  src={image}
                  alt={displayName}
                  preset="avatar"
                  fit="cover"
                  width={400}
                  loading="eager"
                />
              </div>
            )}
            <div class="ajas-profile-meta">
              <h1>{displayName}</h1>
              {credentials && <p class="ajas-profile-cred">{credentials}</p>}
              {role && <p class="ajas-profile-role">{role}</p>}
              <a class="ajas-profile-back" href="/faculties/">
                ← All faculty
              </a>
            </div>
            {bodyHtml && (
              <div class="ajas-profile-bio ajas-prose" set:html={bodyHtml} />
            )}
          </div>
        </article>
      </div>
    ) : isSmartPage && body ? (
      <SmartPage
        title={entry.data.title}
        body={body}
        permalink={perm}
        image={image}
        attachments={attachments}
      />
    ) : !body &&
      !bodyHtml &&
      ((gallery && gallery.length > 0) ||
        (people && people.length > 0) ||
        (menuItems && menuItems.length > 0) ||
        (videos && videos.length > 0)) ? null : bodyHtml ? (
      <ArticleShell wide={t === "listing"} variant={t === "listing" ? "listing" : "info"}>
        <Fragment set:html={bodyHtml} />
        {attachments && attachments.length > 0 && (
          <AttachmentList items={attachments} />
        )}
      </ArticleShell>
    ) : (
      <ArticleShell wide={t === "listing"} variant={t === "listing" ? "listing" : "info"}>
        <Content />
        {attachments && attachments.length > 0 && (
          <AttachmentList items={attachments} />
        )}
      </ArticleShell>
    )
  }
  {
    !isEntity && !isProfile && people && people.length > 0 && (
      <PeopleGrid people={people} />
    )
  }
  {
    !isEntity && !isProfile && menuItems && menuItems.length > 0 && (
      <MenuGrid items={menuItems} />
    )
  }
  {
    !isEntity && !isProfile && gallery && gallery.length > 0 && (
      <GallerySection images={gallery} title="Gallery" />
    )
  }
  {
    !isEntity && !isProfile && videos && videos.length > 0 && (
      <VideoSection videos={videos} title="Video" />
    )
  }
</BaseLayout>

<style>
  /* Single profile card — no nested ArticleShell */
  .ajas-profile-wrap {
    padding: 28px 16px 56px;
    background: linear-gradient(180deg, #f0f3f8 0%, #f8fafc 35%, #fff 100%);
  }
  .ajas-profile-card {
    max-width: 820px;
    margin: 0 auto;
    background: #fff;
    border-radius: 12px;
    padding: 28px 24px 32px;
    box-shadow: 0 10px 36px rgba(24, 50, 81, 0.08);
  }
  @media (min-width: 768px) {
    .ajas-profile-card {
      padding: 36px 40px 40px;
    }
  }
  .ajas-profile {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .ajas-profile {
      grid-template-columns: 200px 1fr;
      grid-template-areas:
        "photo meta"
        "bio bio";
      column-gap: 1.75rem;
    }
    .ajas-profile-photo {
      grid-area: photo;
    }
    .ajas-profile-meta {
      grid-area: meta;
      align-self: center;
    }
    .ajas-profile-bio {
      grid-area: bio;
      margin-top: 0.5rem;
      padding-top: 1.25rem;
      border-top: 1px solid #e8eef4;
    }
  }
  .ajas-profile-photo img {
    width: 100%;
    max-width: 220px;
    aspect-ratio: 3 / 4;
    border-radius: 10px;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  .ajas-profile-meta h1 {
    margin: 0 0 0.35em;
    font-size: 1.6rem;
    color: #183251;
  }
  .ajas-profile-cred,
  .ajas-profile-role {
    margin: 0.15em 0;
    color: #475569;
  }
  .ajas-profile-role {
    font-weight: 600;
    color: #3f4c99;
  }
  .ajas-profile-back {
    display: inline-block;
    margin-top: 0.85rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #3f4c99;
    text-decoration: none;
  }
  .ajas-profile-back:hover {
    color: #ff5f60;
  }
</style>
