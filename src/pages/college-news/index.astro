---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialListing from "../../components/EditorialListing.astro";
import { getListings } from "../../lib/site";

const news = (await getCollection("news", ({ data }) => !data.draft)).sort((a, b) => {
  const da = a.data.date ? +new Date(a.data.date) : 0;
  const db = b.data.date ? +new Date(b.data.date) : 0;
  return db - da || a.data.title.localeCompare(b.data.title);
});
const L = (await getListings())?.news ?? {
  title: "News",
  description: "Campus news from Al Jamia Arts & Science College.",
  intro: "Announcements, achievements and campus happenings from Al Jamia Arts & Science College.",
};
---

<BaseLayout title={L.title} description={L.description} pageTitle={L.title}>
  <EditorialListing kind="news" intro={L.intro} items={news.map((n) => n.data)} />
</BaseLayout>
