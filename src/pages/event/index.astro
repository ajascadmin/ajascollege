---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CmsImage from "../../components/CmsImage.astro";
import { getListings } from "../../lib/site";

const events = (await getCollection("events", ({ data }) => !data.draft)).sort((a, b) => {
  const da = a.data.date ? +new Date(a.data.date) : 0;
  const db = b.data.date ? +new Date(b.data.date) : 0;
  return db - da || a.data.title.localeCompare(b.data.title);
});
const L = (await getListings())?.events ?? {
  title: "Events",
  description: "Events at Al Jamia Arts & Science College.",
  intro: "Campus events, programmes and outreach activities.",
};
---

<BaseLayout title={L.title} description={L.description} pageTitle={L.title}>
  <div class="ajas-listing">
    <div class="container">
      <p class="listing-intro">{L.intro}</p>
      <div class="ajas-grid">
        {
          events.map((e) => (
            <article class="ajas-card">
              <a class="ajas-card-media" href={e.data.permalink}>
                {e.data.image ? (
                  <CmsImage src={e.data.image} alt="" preset="card" fit="cover" />
                ) : (
                  <div class="ajas-card-ph" />
                )}
                <span class="ajas-card-badge">Event</span>
                {e.data.date && (
                  <time
                    class="ajas-card-date"
                    datetime={new Date(e.data.date).toISOString()}
                  >
                    {new Date(e.data.date).toLocaleDateString("en-IN", {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                    })}
                  </time>
                )}
              </a>
              <div class="ajas-card-body">
                <h2>
                  <a href={e.data.permalink}>{e.data.title}</a>
                </h2>
                <a
                  class="ajas-card-more"
                  href={e.data.permalink}
                  aria-label={`View details: ${e.data.title}`}
                >
                  View details <i class="fa fa-long-arrow-right" aria-hidden="true" />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .ajas-listing {
    padding: 40px 0 64px;
    background: #f6f8fb;
    min-height: 40vh;
  }
  .listing-intro {
    max-width: 40rem;
    margin: 0 0 30px;
    color: #4b5b70;
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .ajas-grid {
    display: grid;
    gap: 22px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .ajas-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1000px) {
    .ajas-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .ajas-card {
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 8px 26px rgba(24, 50, 81, 0.09);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .ajas-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(24, 50, 81, 0.14);
  }
  .ajas-card-media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #eef2f7;
  }
  .ajas-card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .ajas-card:hover .ajas-card-media :global(img) {
    transform: scale(1.05);
  }
  .ajas-card-ph {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #183251, #3f4c99);
  }
  .ajas-card-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #ff5f60;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .ajas-card-date {
    position: absolute;
    left: 12px;
    bottom: 12px;
    background: rgba(24, 50, 81, 0.85);
    color: #fff;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 5px 11px;
    border-radius: 999px;
    backdrop-filter: blur(2px);
  }
  .ajas-card-body {
    padding: 16px 18px 18px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .ajas-card-body h2 {
    font-size: 1.05rem;
    margin: 0 0 12px;
    line-height: 1.4;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ajas-card-body h2 a {
    color: #183251;
    text-decoration: none;
  }
  .ajas-card-body h2 a:hover {
    color: #ff5f60;
  }
  .ajas-card-more {
    font-size: 0.85rem;
    font-weight: 600;
    color: #ff5f60;
    text-decoration: none;
  }
  .ajas-card-more i {
    margin-left: 4px;
    transition: transform 0.2s;
  }
  .ajas-card:hover .ajas-card-more i {
    transform: translateX(4px);
  }
</style>
