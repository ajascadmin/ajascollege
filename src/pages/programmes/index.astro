---
/**
 * Programmes index — same image-led language as /departments/.
 *
 * Programme entries carry no artwork of their own, but every programme is
 * taught by a department that does. Matching the two on a keyword gives each
 * card a real photograph instead of fourteen identical gradient icons, and
 * doubles as a useful cross-link into the department.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CmsImage from "../../components/CmsImage.astro";
import { getChildPages } from "../../lib/pageListing";
import { getListings } from "../../lib/site";

const programmes = (await getCollection("programmes", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
const departments = await getChildPages("/departments/");

/** programme keyword → the slug fragment of the department that teaches it */
const DEPT_FOR: [RegExp, string][] = [
  [/islamic finance/i, "islamic-finance"],
  [/islamic studies/i, "islamic-studies"],
  [/arabic/i, "arabic"],
  [/english/i, "english"],
  [/psychology/i, "psychology"],
  [/geography/i, "geography"],
  [/food tech/i, "food-technology"],
  [/micro ?biology/i, "micro-biology"],
  [/artificial intelligence|computer science/i, "computer-science"],
  [/bca|computer application/i, "computer-application"],
  [/b\.?\s?com|bba|commerce|management/i, "commerce"],
  [/economics/i, "economics"],
  [/physical education/i, "physical-education"],
];

function departmentFor(title: string) {
  for (const [re, slug] of DEPT_FOR) {
    if (!re.test(title)) continue;
    const hit = departments.find((d) => d.permalink.includes(slug));
    if (hit) return hit;
  }
  return undefined;
}

const shortDept = (t: string) =>
  t.replace(/^(pg\s+)?department\s+of\s+/i, "").replace(/^non[-\s]core\s+departments?\s*[-–]?\s*/i, "");

type Row = (typeof programmes)[number] & { _dept?: ReturnType<typeof departmentFor> };
const decorate = (list: typeof programmes) =>
  list.map((p) => ({ entry: p, dept: departmentFor(p.data.title) }));

const ug = decorate(programmes.filter((p) => p.data.level === "ug"));
const pg = decorate(programmes.filter((p) => p.data.level === "pg"));
const other = decorate(programmes.filter((p) => !["ug", "pg"].includes(p.data.level)));

const groups = [
  {
    id: "ug",
    badge: "Undergraduate",
    title: "UG (Honours) Programmes",
    note: "Four-year Honours degrees under FYUGP, University of Calicut",
    rows: ug,
  },
  {
    id: "pg",
    badge: "Postgraduate",
    title: "PG Programmes",
    note: "Two-year Master's degrees with research supervision",
    rows: pg,
  },
  { id: "other", badge: "Other", title: "Other Programmes", note: "", rows: other },
].filter((g) => g.rows.length > 0);

const L = (await getListings())?.programmes ?? {
  title: "Programmes Offered",
  description: "UG (Honours) and PG programmes at Al Jamia Arts & Science College.",
  intro:
    "Al Jamia Arts and Science College offers university-affiliated Four-Year Undergraduate (Honours) programmes under FYUGP and specialised Postgraduate degrees with dedicated faculty and state-of-the-art labs.",
};

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Programmes offered — Al Jamia Arts & Science College",
  numberOfItems: programmes.length,
  itemListElement: programmes.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: p.data.title,
    url: new URL(p.data.permalink, "https://ajascollege.ac.in").href,
  })),
};
---

<BaseLayout title={L.title} description={L.description} pageTitle={L.title} jsonLd={itemListLd}>
  <div class="px" data-pagefind-body>
    <div class="px-inner">
      <header class="px-head">
        <div>
          <p class="px-intro">{L.intro}</p>
          <div class="px-ctas">
            <a class="px-btn" href="/admission/">Apply for admission</a>
            <a class="px-btn px-btn-alt" href="/fees/">Fees &amp; prospectus</a>
          </div>
        </div>
        <dl class="px-stats">
          <div>
            <dt>Programmes</dt>
            <dd>{programmes.length}</dd>
          </div>
          <div>
            <dt>UG Honours</dt>
            <dd>{ug.length}</dd>
          </div>
          <div>
            <dt>Postgraduate</dt>
            <dd>{pg.length}</dd>
          </div>
        </dl>
      </header>

      {
        groups.map((g) => (
          <section class="px-group" id={g.id}>
            <header class="px-group-head">
              <span class={`px-badge px-badge-${g.id}`}>{g.badge}</span>
              <h2>{g.title}</h2>
              {g.note && <p>{g.note}</p>}
            </header>

            <ul class="px-grid">
              {g.rows.map(({ entry: p, dept }) => (
                <li>
                  <a class="px-card" href={p.data.permalink}>
                    <span class="px-media">
                      {dept?.image ? (
                        <CmsImage src={dept.image} alt="" preset="card" fit="cover" loading="lazy" />
                      ) : (
                        <span class="px-media-fallback" aria-hidden="true" />
                      )}
                      <span class="px-veil" aria-hidden="true" />
                      <span class="px-title">{p.data.title}</span>
                    </span>
                    <span class="px-body">
                      <span class="px-facts">
                        {p.data.duration && (
                          <span class="px-fact">
                            <span>Duration</span>
                            <strong>{p.data.duration}</strong>
                          </span>
                        )}
                        {dept && (
                          <span class="px-fact">
                            <span>Department</span>
                            <strong>{shortDept(dept.title)}</strong>
                          </span>
                        )}
                        {p.data.seats && (
                          <span class="px-fact">
                            <span>Intake</span>
                            <strong>{p.data.seats}</strong>
                          </span>
                        )}
                      </span>
                      <span class="px-more">
                        View details
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .px {
    background: #fff;
    padding: 30px 0 56px;
  }
  .px-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3.4vw, 56px);
  }

  /* ---- head ---- */
  .px-head {
    display: grid;
    gap: 26px clamp(32px, 5vw, 80px);
    align-items: end;
    padding-bottom: 26px;
    margin-bottom: 38px;
    border-bottom: 2px solid #17304f;
  }
  @media (min-width: 900px) {
    .px-head {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
  .px-intro {
    margin: 0;
    max-width: 62ch;
    font-size: 1.12rem;
    line-height: 1.7;
    color: #47586f;
  }
  .px-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  .px-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 22px;
    border-radius: 0;
    background: #ff5f60;
    color: #fff;
    font-size: 14.5px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .px-btn:hover {
    background: #e04a4b;
    color: #fff;
  }
  .px-btn-alt {
    background: none;
    color: #17304f;
    border: 1px solid #d9e1ec;
  }
  .px-btn-alt:hover {
    background: #f4f7fb;
    color: #17304f;
    border-color: #17304f;
  }
  /* same hairline grid as the recognitions block */
  .px-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    background: #e4eaf1;
    border: 1px solid #e4eaf1;
  }
  .px-stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 3px;
    padding: 14px 20px;
    background: #fff;
  }
  .px-stats dt {
    margin: 0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #91a0b4;
  }
  .px-stats dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1;
    color: #17304f;
  }

  /* ---- groups ---- */
  .px-group + .px-group {
    margin-top: 48px;
  }
  .px-group-head {
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid #e4eaf1;
  }
  .px-badge {
    display: inline-block;
    margin-bottom: 8px;
    padding: 3px 10px;
    border-radius: 0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #17304f;
    background: #eef3f9;
    border: 1px solid #dce5f0;
  }
  .px-badge-pg {
    color: #9b3440;
    background: #fbf1f2;
    border-color: #f0dcde;
  }
  .px-group-head h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2vw, 1.9rem);
    font-weight: 600;
    line-height: 1.16;
    letter-spacing: -0.015em;
    color: #17304f;
  }
  .px-group-head p {
    margin: 6px 0 0;
    font-size: 0.95rem;
    color: #6b7a90;
  }

  /* ---- cards ---- */
  .px-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(18px, 2vw, 28px);
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  }
  .px-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    text-decoration: none !important;
    color: inherit;
    border: 1px solid #e4eaf1;
    border-radius: 0;
    overflow: hidden;
    background: #fff;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }
  .px-card:hover {
    transform: translateY(-4px);
    border-color: #cfd9e6;
    box-shadow: 0 20px 44px rgba(17, 48, 79, 0.14);
  }
  .px-media {
    position: relative;
    display: block;
    aspect-ratio: 21 / 9;
    background: #10263f;
    overflow: hidden;
  }
  .px-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .px-card:hover .px-media :global(img) {
    transform: scale(1.05);
  }
  .px-media-fallback {
    position: absolute;
    inset: 0;
    background: linear-gradient(140deg, #17304f, #0d1f36);
  }
  .px-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(8, 22, 38, 0.92) 0%,
      rgba(8, 22, 38, 0.52) 44%,
      rgba(8, 22, 38, 0.1) 78%
    );
  }
  .px-title {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 13px;
    font-family: var(--font-serif);
    font-size: 1.24rem;
    font-weight: 600;
    line-height: 1.2;
    color: #fff;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
  }
  .px-title::before {
    content: "";
    display: block;
    width: 24px;
    height: 2px;
    background: #ff5f60;
    margin-bottom: 8px;
  }

  .px-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 0;
  }
  /* facts as a hairline row, matching the boxy language used elsewhere */
  .px-facts {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 1px;
    background: #eef2f7;
    border-bottom: 1px solid #eef2f7;
  }
  .px-fact {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 11px 14px;
    background: #fff;
    min-width: 0;
  }
  .px-fact span {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #97a5b8;
  }
  .px-fact strong {
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.35;
    color: #2b3d55;
  }
  .px-more {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    font-size: 0.82rem;
    font-weight: 700;
    color: #ff5f60;
  }
  .px-more svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.22s ease;
  }
  .px-card:hover .px-more svg {
    transform: translateX(4px);
  }

  @media (max-width: 767px) {
    .px {
      padding: 20px 0 36px;
    }
    .px-head {
      margin-bottom: 26px;
      padding-bottom: 20px;
    }
    .px-intro {
      font-size: 1rem;
    }
    .px-stats dd {
      font-size: 1.4rem;
    }
    .px-stats div {
      padding: 11px 12px;
    }
    /* "POSTGRADUATE" broke across two lines in a narrow cell */
    .px-stats dt {
      font-size: 9px;
      letter-spacing: 0.06em;
    }
    .px-grid {
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 16px;
    }
    .px-media {
      aspect-ratio: 16 / 9;
    }
    .px-title {
      font-size: 1.12rem;
    }
    .px-group + .px-group {
      margin-top: 34px;
    }
  }
</style>
