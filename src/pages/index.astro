---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeSections from "../components/home/HomeSections.astro";
import { getHomepage } from "../lib/site";

const home = await getHomepage();
if (!home) {
  throw new Error("Missing content/home/homepage.json");
}
---

<BaseLayout title={home.title} description={home.description} variant="home">
  <HomeSections data={home} />
</BaseLayout>
