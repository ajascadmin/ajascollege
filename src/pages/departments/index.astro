---
/**
 * Departments index — image-led. Every department already carries a lead
 * photograph; the previous grid hid all of them behind a generic gradient
 * icon, so fourteen departments looked identical.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import CmsImage from "../../components/CmsImage.astro";
import { getChildPages } from "../../lib/pageListing";
import { getListings } from "../../lib/site";

const depts = await getChildPages("/departments/");

/** Fallback mark for a department with no photograph of its own. */
const iconFor = (title: string) => {
  const t = title.toLowerCase();
  if (t.includes("computer application")) return "fa-laptop";
  if (t.includes("computer science")) return "fa-desktop";
  if (t.includes("arabic")) return "fa-language";
  if (t.includes("commerce")) return "fa-briefcase";
  if (t.includes("geography")) return "fa-globe";
  if (t.includes("islamic finance")) return "fa-university";
  if (t.includes("english")) return "fa-book";
  if (t.includes("food technology")) return "fa-cutlery";
  if (t.includes("physical education")) return "fa-futbol-o";
  if (t.includes("microbiology") || t.includes("micro biology")) return "fa-flask";
  if (t.includes("languages")) return "fa-comments";
  if (t.includes("islamic studies")) return "fa-moon-o";
  if (t.includes("economics") || t.includes("non core")) return "fa-line-chart";
  if (t.includes("psychology")) return "fa-lightbulb-o";
  return "fa-graduation-cap";
};

/** "Department of Commerce & Management Studies" → "Commerce & Management Studies" */
const shortName = (t: string) =>
  t.replace(/^(pg\s+)?department\s+of\s+/i, "").replace(/^non[-\s]core\s+departments?\s*[-–]?\s*/i, "");

const L = (await getListings())?.departments ?? {
  title: "Departments",
  description:
    "Fourteen departments offering UG (Honours) and PG programmes affiliated to the University of Calicut.",
  intro:
    "Fourteen departments offering UG (Honours) and PG programmes affiliated to the University of Calicut.",
};

const courseCount = depts.reduce((a, d) => a + d.courses.length, 0);

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Departments — Al Jamia Arts & Science College",
  numberOfItems: depts.length,
  itemListElement: depts.map((d, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: d.title,
    url: new URL(d.permalink, "https://ajascollege.ac.in").href,
  })),
};
---

<BaseLayout title={L.title} description={L.description} pageTitle={L.title} jsonLd={itemListLd}>
  <div class="dx">
    <div class="dx-inner">
      <header class="dx-head">
        <p class="dx-intro">{L.intro}</p>
        <dl class="dx-stats">
          <div>
            <dt>Departments</dt>
            <dd>{depts.length}</dd>
          </div>
          {courseCount > 0 && (
            <div>
              <dt>Programmes listed</dt>
              <dd>{courseCount}</dd>
            </div>
          )}
          <div>
            <dt>Affiliation</dt>
            <dd class="dx-stat-text">University of Calicut</dd>
          </div>
        </dl>
      </header>

      <ul class="dx-grid">
        {
          depts.map((d) => (
            <li class="dx-item">
              <a class="dx-card" href={d.permalink}>
                <span class="dx-media">
                  {d.image ? (
                    <CmsImage src={d.image} alt="" preset="card" fit="cover" loading="lazy" />
                  ) : (
                    <span class="dx-media-fallback" aria-hidden="true">
                      <i class={`fa ${iconFor(d.title)}`} />
                    </span>
                  )}
                  <span class="dx-media-veil" aria-hidden="true" />
                  <span class="dx-title">{shortName(d.title)}</span>
                </span>

                <span class="dx-body">
                  {d.blurb && <span class="dx-blurb">{d.blurb}</span>}
                  {d.courses.length > 0 && (
                    <span class="dx-courses">
                      {d.courses.map((c) => (
                        <span class="dx-pill">{c}</span>
                      ))}
                    </span>
                  )}
                  <span class="dx-more">
                    Explore department
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .dx {
    background: #fff;
    padding: 30px 0 56px;
  }
  .dx-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3.4vw, 56px);
  }

  /* ---- head: intro left, hard numbers right ---- */
  .dx-head {
    display: grid;
    gap: 26px clamp(32px, 5vw, 80px);
    align-items: end;
    padding-bottom: 26px;
    margin-bottom: 34px;
    border-bottom: 2px solid #17304f;
  }
  @media (min-width: 900px) {
    .dx-head {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
  .dx-intro {
    margin: 0;
    max-width: 62ch;
    font-size: 1.12rem;
    line-height: 1.7;
    color: #47586f;
  }
  .dx-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 36px;
    margin: 0;
  }
  .dx-stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
  }
  .dx-stats dt {
    margin: 0;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #91a0b4;
  }
  .dx-stats dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.9rem;
    font-weight: 600;
    line-height: 1;
    color: #17304f;
  }
  .dx-stats dd.dx-stat-text {
    font-size: 1.05rem;
    line-height: 1.3;
    padding-top: 6px;
  }

  /* ---- grid ---- */
  .dx-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(18px, 2vw, 30px);
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
  }
  .dx-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    text-decoration: none !important;
    color: inherit;
    border: 1px solid #e4eaf1;
    border-radius: 0;
    overflow: hidden;
    background: #fff;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }
  .dx-card:hover {
    transform: translateY(-4px);
    border-color: #cfd9e6;
    box-shadow: 0 20px 44px rgba(17, 48, 79, 0.14);
  }

  /* ---- the photograph is the card ---- */
  .dx-media {
    position: relative;
    display: block;
    aspect-ratio: 21 / 9;
    background: #10263f;
    overflow: hidden;
  }
  .dx-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .dx-card:hover .dx-media :global(img) {
    transform: scale(1.05);
  }
  .dx-media-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40px;
    color: rgba(255, 255, 255, 0.5);
    background: linear-gradient(140deg, #17304f, #0d1f36);
  }
  .dx-media-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(8, 22, 38, 0.92) 0%,
      rgba(8, 22, 38, 0.55) 42%,
      rgba(8, 22, 38, 0.12) 72%,
      rgba(8, 22, 38, 0.05) 100%
    );
  }
  .dx-title {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 15px;
    font-family: var(--font-serif);
    font-size: 1.28rem;
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.01em;
    color: #fff;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
  }
  .dx-title::before {
    content: "";
    display: block;
    width: 26px;
    height: 2px;
    background: #ff5f60;
    margin-bottom: 9px;
  }

  /* ---- body ---- */
  .dx-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
    padding: 14px 18px 13px;
  }
  .dx-blurb {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #61718a;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .dx-courses {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .dx-pill {
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.3;
    padding: 4px 9px;
    border-radius: 0;
    background: #f2f6fb;
    border: 1px solid #e3ebf4;
    color: #43556e;
  }
  .dx-more {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid #eef2f7;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #ff5f60;
  }
  .dx-more svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.22s ease;
  }
  .dx-card:hover .dx-more svg {
    transform: translateX(4px);
  }

  @media (max-width: 767px) {
    .dx {
      padding: 20px 0 36px;
    }
    .dx-head {
      padding-bottom: 20px;
      margin-bottom: 24px;
      gap: 18px;
    }
    .dx-intro {
      font-size: 1rem;
    }
    .dx-stats {
      gap: 8px 26px;
    }
    .dx-stats dd {
      font-size: 1.5rem;
    }
    .dx-grid {
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 16px;
    }
    .dx-media {
      aspect-ratio: 16 / 9;
    }
    .dx-title {
      font-size: 1.14rem;
    }
  }
</style>
