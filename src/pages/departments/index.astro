---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getChildPages } from "../../lib/pageListing";

const depts = await getChildPages("/departments/");

const iconFor = (title: string) => {
  const t = title.toLowerCase();
  if (t.includes("computer application")) return "fa-laptop";
  if (t.includes("computer science")) return "fa-desktop";
  if (t.includes("arabic")) return "fa-language";
  if (t.includes("commerce")) return "fa-briefcase";
  if (t.includes("geography")) return "fa-globe";
  if (t.includes("islamic finance")) return "fa-university";
  if (t.includes("english")) return "fa-book";
  if (t.includes("food technology")) return "fa-cutlery";
  if (t.includes("physical education")) return "fa-futbol-o";
  if (t.includes("microbiology") || t.includes("micro biology")) return "fa-flask";
  if (t.includes("languages")) return "fa-comments";
  if (t.includes("islamic studies")) return "fa-moon-o";
  if (t.includes("economics") || t.includes("non core")) return "fa-line-chart";
  if (t.includes("psychology")) return "fa-lightbulb-o";
  return "fa-graduation-cap";
};
---

<BaseLayout
  title="Departments"
  description="Fourteen departments offering UG (Honours) and PG programmes affiliated to the University of Calicut."
  pageTitle="Departments"
>
  <div class="ajas-listing">
    <div class="container">
      <p class="listing-intro">
        Fourteen departments offering UG (Honours) and PG programmes affiliated to the University
        of Calicut.
      </p>
      <div class="dept-grid">
        {
          depts.map((d) => (
            <a class="dept-card" href={d.permalink}>
              <span class="dept-ico">
                <i class={`fa ${iconFor(d.title)}`} aria-hidden="true" />
              </span>
              <h2>{d.title}</h2>
              {d.blurb && <p>{d.blurb}</p>}
              <span class="dept-more">
                Explore department <i class="fa fa-long-arrow-right" aria-hidden="true" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .ajas-listing {
    padding: 48px 0 72px;
    background: #f8fafc;
    min-height: 50vh;
  }
  .listing-intro {
    max-width: 44rem;
    margin: 0 0 36px;
    color: #475569;
    font-size: 1.08rem;
    line-height: 1.65;
  }
  .dept-grid {
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .dept-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1000px) {
    .dept-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .dept-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 28px 24px 22px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 8px 26px rgba(24, 50, 81, 0.06);
    text-decoration: none !important;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .dept-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 48px rgba(24, 50, 81, 0.13);
    border-color: #cbd5e1;
  }
  .dept-ico {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: linear-gradient(135deg, #183251, #24436c);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    margin-bottom: 18px;
    box-shadow: 0 6px 16px rgba(24, 50, 81, 0.18);
    transition: transform 0.3s ease;
  }
  .dept-card:hover .dept-ico {
    transform: scale(1.08) rotate(2deg);
    background: linear-gradient(135deg, #ff5f60, #e04a4b);
  }
  .dept-card h2 {
    margin: 0 0 10px;
    font-size: 1.15rem;
    font-weight: 700;
    color: #183251;
    line-height: 1.35;
    transition: color 0.2s ease;
  }
  .dept-card:hover h2 {
    color: #ff5f60;
  }
  .dept-card p {
    margin: 0 0 18px;
    font-size: 0.92rem;
    color: #64748b;
    line-height: 1.62;
    flex: 1;
  }
  .dept-more {
    font-size: 0.88rem;
    font-weight: 700;
    color: #ff5f60;
    display: flex;
    align-items: center;
    padding-top: 14px;
    border-top: 1px solid #f1f5f9;
  }
  .dept-more i {
    margin-left: 6px;
    transition: transform 0.2s ease;
  }
  .dept-card:hover .dept-more i {
    transform: translateX(5px);
  }
</style>
