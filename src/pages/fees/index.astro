---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleShell from "../../components/ArticleShell.astro";
import { getSiteSettings, getListings } from "../../lib/site";

const fees = (await getCollection("fees", ({ data }) => !data.draft)).sort((a, b) => {
  const da = a.data.date ? +new Date(a.data.date) : 0;
  const db = b.data.date ? +new Date(b.data.date) : 0;
  return db - da;
});
const site = await getSiteSettings();
const L = (await getListings())?.fees ?? {
  title: "Fees & Prospectus",
  description: "Fee structure and prospectus downloads — Al Jamia Arts & Science College.",
  intro: "Fee structure and prospectus documents for the current academic year.",
};
---

<BaseLayout title={L.title} description={L.description} pageTitle={L.title}>
  <ArticleShell variant="listing">
                <p class="listing-intro">{L.intro}</p>

                {
                  site.fee_pdf && (
                    <p>
                      <a class="flat-button" href={site.fee_pdf} target="_blank" rel="noopener">
                        Current fee structure (quick link)
                      </a>
                    </p>
                  )
                }

                <table class="mig-roster ajas-download-table">
                  <thead>
                    <tr>
                      <th>Document</th>
                      <th>Date</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    {
                      fees.map((f) => (
                        <tr>
                          <td class="nm">{f.data.title}</td>
                          <td class="rl">
                            {f.data.date
                              ? new Date(f.data.date).toLocaleDateString("en-IN", {
                                  year: "numeric",
                                  month: "short",
                                  day: "numeric",
                                })
                              : "—"}
                          </td>
                          <td>
                            <a href={f.data.file} target="_blank" rel="noopener">
                              Download
                            </a>
                          </td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>

                <p>
                  <a href="/payments/">Bank / payment details</a>
                  {" · "}
                  <a href="/scholorship/">Scholarships</a>
                  {" · "}
                  <a href="/admission/">Admissions</a>
                </p>
  </ArticleShell>
</BaseLayout>
