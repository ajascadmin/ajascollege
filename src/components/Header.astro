---
/**
 * Site header = navigation (SiteNav) + the inner-page title band + the
 * admissions strip. The nav itself is a standalone component; this file only
 * decides what chrome sits around it for a given page variant.
 */
import SiteNav from "./nav/SiteNav.astro";
import { getSiteSettings } from "../lib/site";

interface Props {
  variant?: "home" | "inner";
  pageTitle?: string;
  breadcrumbs?: { label: string; href?: string }[];
  /** "p" where the article below already provides the page's <h1>. */
  titleAs?: "h1" | "p";
}

const { variant = "inner", pageTitle, breadcrumbs = [], titleAs = "h1" } = Astro.props;
const BandTitle = titleAs;
const site = await getSiteSettings();
const isHome = variant === "home";

/* The trail's last crumb is the current page, which the <h1> right below it
   already says — printing both read as the title rendered twice. Keep the
   trail as ancestors only. */
/* A crumb with no href IS the current page, so the trail is already complete
   and the band title must not be appended after it. Two cases this gets right
   that the previous version did not: an article whose band title is the
   section name ("… / Outreach Awareness Programme" + band "Events"), and a
   page whose last crumb already equals its own title. */
const last = breadcrumbs[breadcrumbs.length - 1];
const trail = breadcrumbs;
const appendTitle = !!pageTitle && !(last && !last.href);
---

<SiteNav variant={variant} />


{
  !isHome && pageTitle && (
    <div class="ajas-pagehead">
      <div class="ajas-pagehead-inner">
        {trail.length > 0 && (
          <nav class="ajas-crumbs" aria-label="Breadcrumb">
            <ol>
              {trail.map((c) => (
                <li {...(!c.href ? { "aria-current": "page" } : {})}>
                  {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
                </li>
              ))}
              {appendTitle && (
                <li aria-current="page">
                  <span>{pageTitle}</span>
                </li>
              )}
            </ol>
          </nav>
        )}
        <BandTitle class="ajas-pagehead-title">{pageTitle}</BandTitle>
      </div>
    </div>
  )
}

<style is:global>
  /* ---------- inner page title band ---------- */
  .ajas-pagehead {
    position: relative;
    background-image: linear-gradient(90deg, rgba(10, 28, 49, 0.93) 0%, rgba(10, 28, 49, 0.78) 55%, rgba(10, 28, 49, 0.6) 100%),
      var(--ajas-campus-bg, url("/images/home1/23.jpg"));
    background-size: cover;
    background-position: center 38%;
    color: #fff;
  }
  .ajas-pagehead-inner {
    max-width: 1560px;
    margin: 0 auto;
    padding: 34px 32px 36px;
  }
  .ajas-crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0 0 10px;
    padding: 0;
    list-style: none;
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.62);
  }
  .ajas-crumbs li + li::before {
    content: "/";
    margin-right: 6px;
    color: rgba(255, 255, 255, 0.34);
  }
  .ajas-crumbs a {
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
  }
  .ajas-crumbs a:hover {
    color: #fff;
  }
  .ajas-crumbs li:last-child span {
    color: #ffc24a;
  }
  .ajas-pagehead-title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.75rem, 3.6vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    max-width: 22ch;
    color: #fff;
  }
  @media (max-width: 991px) {
    .ajas-pagehead-inner {
      padding: 26px 24px 28px;
    }
  }
  @media (max-width: 767px) {
    .ajas-pagehead-inner {
      padding: 20px 16px 22px;
    }
    .ajas-crumbs ol {
      flex-wrap: nowrap;
      overflow-x: auto;
      white-space: nowrap;
      scrollbar-width: none;
      margin-bottom: 8px;
    }
    .ajas-crumbs ol::-webkit-scrollbar {
      display: none;
    }
    .ajas-pagehead-title {
      font-size: clamp(1.45rem, 6.4vw, 2rem);
      max-width: none;
      overflow-wrap: anywhere;
    }
  }
</style>
