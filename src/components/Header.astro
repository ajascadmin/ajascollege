---
import { getSiteSettings } from "../lib/site";
import NavMenu from "./NavMenu.astro";
import type { NavItem } from "./NavMenu.astro";
import navigation from "../../content/settings/navigation.json";
import CmsImage from "./CmsImage.astro";

interface Props {
  variant?: "home" | "inner";
}

const { variant = "inner" } = Astro.props;
const isHome = variant === "home";
const site = await getSiteSettings();

const phoneDisplay = site.phone_display || site.phone;
const phoneHref = `tel:${String(site.phone).replace(/\s/g, "")}`;
const logo = site.logo || "/assets/uploads/2024/01/AJAS-Website-Heading-Last.svg";
const menu = (navigation as { main: NavItem[] }).main;
// SVG logos stay in public/ (not optimized by Sharp); raster logos use CmsImage.
const logoIsRaster = /\.(jpe?g|png|webp|gif|avif)$/i.test(logo);
---

{
  isHome ? (
    <div class="wrap-header">
      <div class="flat-header flat-header-style2 ajas-home-header">
        <div class="top-bar clearfix">
          <div class="container">
            <div class="row">
              <div class="col-lg-5 col-md-6 col-sm-12">
                <ul class="information">
                  <li class="phone lt-sp003">
                    <i class="fa fa-phone" aria-hidden="true" />{" "}
                    <a href={phoneHref}>{phoneDisplay}</a>
                  </li>
                  <li class="email">
                    <i class="fa fa-envelope" aria-hidden="true" />{" "}
                    <a href={`mailto:${site.email}`}>{site.email}</a>
                  </li>
                </ul>
              </div>
              <div class="col-lg-7 col-md-6 col-sm-12">
                <ul class="nav-sing top-utility">
                  <li><a href="/alumnae/">Alumni</a></li>
                  <li><a href="/placement-cell/">Placement Cell</a></li>
                  <li><a href="/student-life/">Students Corner</a></li>
                  <li><a href="/payments/">Payments</a></li>
                  <li><a href="/career/">Career</a></li>
                  <li><a href="/contact/">Contact Us</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
        <header class="header header-blog menu-bar hv-menu-type2">
          <div class="container">
            <div class="menu-bar-wrap clearfix">
              <div id="logo" class="logo">
                <a href="/">
                  {logoIsRaster ? (
                    <CmsImage
                      src={logo}
                      alt={site.college_name || "AJAS College"}
                      preset="logo"
                      fit="contain"
                      loading="eager"
                      fetchpriority="high"
                    />
                  ) : (
                    <img
                      src={logo}
                      alt={site.college_name || "AJAS College"}
                      width="220"
                      height="48"
                      loading="eager"
                      decoding="async"
                      fetchpriority="high"
                    />
                  )}
                </a>
              </div>
              <button
                class="mobile-button"
                type="button"
                aria-label="Open navigation menu"
                aria-expanded="false"
                aria-controls="main-nav"
              ><span /></button>
              <div class="header-menu">
                <nav id="main-nav" class="main-nav">
                  <NavMenu items={menu} />
                </nav>
              </div>
            </div>
          </div>
        </header>
      </div>
    </div>
  ) : (
    <div class="bg-header">
      <div class="flat-header-blog">
        <div class="top-bar clearfix">
          <div class="container">
            <div class="row">
              <div class="col-lg-5 col-md-6 col-sm-12">
                <ul class="information">
                  <li class="phone lt-sp003">
                    <i class="fa fa-phone" aria-hidden="true" />{" "}
                    <a href={phoneHref}>{phoneDisplay}</a>
                  </li>
                  <li class="email">
                    <i class="fa fa-envelope" aria-hidden="true" />{" "}
                    <a href={`mailto:${site.email}`}>{site.email}</a>
                  </li>
                </ul>
              </div>
              <div class="col-lg-7 col-md-6 col-sm-12">
                <ul class="nav-sing top-utility">
                  <li><a href="/alumnae/">Alumni</a></li>
                  <li><a href="/placement-cell/">Placement Cell</a></li>
                  <li><a href="/student-life/">Students Corner</a></li>
                  <li><a href="/payments/">Payments</a></li>
                  <li><a href="/career/">Career</a></li>
                  <li><a href="/contact/">Contact Us</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
        <header class="header header-blog menu-bar hv-menu-type2">
          <div class="container">
            <div class="menu-bar-wrap clearfix">
              <div id="logo" class="logo">
                <a href="/">
                  {logoIsRaster ? (
                    <CmsImage
                      src={logo}
                      alt={site.college_name || "AJAS College"}
                      preset="logo"
                      fit="contain"
                      loading="eager"
                      fetchpriority="high"
                    />
                  ) : (
                    <img
                      src={logo}
                      alt={site.college_name || "AJAS College"}
                      width="220"
                      height="48"
                      loading="eager"
                      decoding="async"
                      fetchpriority="high"
                    />
                  )}
                </a>
              </div>
              <button
                class="mobile-button"
                type="button"
                aria-label="Open navigation menu"
                aria-expanded="false"
                aria-controls="main-nav"
              ><span /></button>
              <div class="header-menu">
                <nav id="main-nav" class="main-nav">
                  <NavMenu items={menu} />
                </nav>
              </div>
            </div>
          </div>
        </header>
        <slot name="page-title" />
      </div>
    </div>
  )
}

{
  site.admission_open && (
    <div class="ajas-admit-strip" role="status">
      <div class="container ajas-admit-inner">
        <a class="ajas-admit-primary" href={site.admission_url || "/admission/"}>
          <strong>{site.admission_label || "Admissions open"}</strong>
          {site.admission_note && (
            <span class="ajas-admit-note">
              <span class="ajas-admit-separator" aria-hidden="true"> — </span>
              {site.admission_note}
            </span>
          )}
        </a>
        <span class="ajas-admit-links">
          {site.fee_pdf && (
            <a href={site.fee_pdf} target="_blank" rel="noopener">
              Fee structure
            </a>
          )}
          <a href="/notices/">Notices</a>
        </span>
      </div>
    </div>
  )
}

<style is:global>
  .ajas-admit-strip {
    background: #183251;
    color: #fff;
    font-size: 14px;
    padding: 8px 0;
    text-align: center;
  }
  .ajas-admit-strip a {
    color: #fff;
    text-decoration: none;
  }
  .ajas-admit-strip a:hover {
    color: #ffbe34;
  }
  .ajas-admit-strip strong {
    color: #ffbe34;
  }
  .ajas-admit-inner,
  .ajas-admit-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }
  .ajas-admit-links a::before {
    content: "\00b7";
    padding: 0 8px;
    color: rgba(255, 255, 255, 0.65);
  }
  @media (max-width: 575px) {
    .ajas-admit-strip {
      padding: 9px 0 10px;
      line-height: 1.45;
    }
    .ajas-admit-inner {
      display: block;
    }
    .ajas-admit-primary {
      display: block;
    }
    .ajas-admit-primary > span {
      display: block;
    }
    .ajas-admit-separator {
      display: none !important;
    }
    .ajas-admit-links {
      gap: 8px;
      margin-top: 5px;
    }
    .ajas-admit-links a {
      min-height: 32px;
      display: inline-flex;
      align-items: center;
      padding: 2px 10px;
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 999px;
      font-size: 12.5px;
    }
    .ajas-admit-links a::before {
      content: none;
    }
  }
</style>
