---
/**
 * Sibling navigation. Someone reading about one department almost always
 * wants the next one, and a dead end at the bottom of every detail page is
 * the most common reason people bounce back to a listing and start over.
 */
interface Item {
  label: string;
  href: string;
}
interface Props {
  prev?: Item | null;
  next?: Item | null;
  indexLabel?: string;
  indexHref?: string;
}
const { prev, next, indexLabel, indexHref } = Astro.props;
---

{
  (prev || next) && (
    <nav class="pn" aria-label="Sibling pages">
      <div class="pn-inner">
        {prev ? (
          <a class="pn-item pn-prev" href={prev.href} rel="prev">
            <span class="pn-dir">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
              Previous
            </span>
            <span class="pn-label">{prev.label}</span>
          </a>
        ) : (
          <span class="pn-item pn-empty" />
        )}

        {indexHref && (
          <a class="pn-index" href={indexHref}>
            {indexLabel}
          </a>
        )}

        {next ? (
          <a class="pn-item pn-next" href={next.href} rel="next">
            <span class="pn-dir">
              Next
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
            <span class="pn-label">{next.label}</span>
          </a>
        ) : (
          <span class="pn-item pn-empty" />
        )}
      </div>
    </nav>
  )
}

<style>
  .pn {
    background: #fff;
  }
  .pn-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3.4vw, 56px) 52px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: 1px;
    background: #dde4ed;
    border: 1px solid #dde4ed;
    margin-top: 34px;
  }
  /* the container padding must not sit inside the hairline grid */
  .pn-inner {
    padding: 0;
    max-width: 1440px;
    margin: 34px clamp(16px, 3.4vw, 56px) 52px;
  }
  @media (min-width: 1552px) {
    .pn-inner {
      margin-left: auto;
      margin-right: auto;
      width: calc(1440px - 2 * clamp(16px, 3.4vw, 56px));
    }
  }
  .pn-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
    background: #fff;
    text-decoration: none !important;
    color: inherit;
    min-width: 0;
    transition: background 0.18s ease;
  }
  a.pn-item:hover {
    background: #f7f9fc;
  }
  .pn-next {
    text-align: right;
    align-items: flex-end;
  }
  .pn-dir {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #a0adbe;
  }
  .pn-dir svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }
  a.pn-item:hover .pn-dir {
    color: #ff5f60;
  }
  .pn-prev:hover .pn-dir svg {
    transform: translateX(-3px);
  }
  .pn-next:hover .pn-dir svg {
    transform: translateX(3px);
  }
  .pn-label {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.3;
    color: #17304f;
  }
  a.pn-item:hover .pn-label {
    color: #ff5f60;
  }
  .pn-index {
    display: flex;
    align-items: center;
    padding: 0 22px;
    background: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #7b8a9e;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.18s ease, color 0.18s ease;
  }
  .pn-index:hover {
    background: #17304f;
    color: #fff;
  }
  @media (max-width: 719px) {
    .pn-inner {
      grid-template-columns: minmax(0, 1fr);
      margin-bottom: 34px;
    }
    .pn-next {
      text-align: left;
      align-items: flex-start;
    }
    .pn-index {
      justify-content: center;
      padding: 14px 20px;
    }
  }
  @media print {
    .pn {
      display: none;
    }
  }
</style>
