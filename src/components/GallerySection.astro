---
/**
 * Structured photo gallery — CMS-editable `gallery` frontmatter list,
 * rendered as a grid with a lightbox instead of stacked inline <img>s.
 */
import CmsImage from "./CmsImage.astro";
import { optimizeCmsImage } from "../lib/cmsImage";

interface Props {
  images: string[];
  title?: string;
  id?: string;
}

const { images, title = "Gallery", id = "page-gallery" } = Astro.props;
const galleryImages = await Promise.all(
  (images || []).map(async (src) => ({
    src,
    href: (await optimizeCmsImage(src, "inline"))?.src || src,
  })),
);
---

{
  images && images.length > 0 && (
    <section class="gallery-section" id={id}>
      <div class="gallery-section-head">
        <span class="gallery-section-line" aria-hidden="true" />
        <h2>{title}</h2>
      </div>
      <div class="gallery-grid">
        {galleryImages.map((image, i) => (
          <a
            class="gal-item"
            href={image.href}
            rel={id}
            title={`${title} ${i + 1} of ${images.length}`}
          >
            <CmsImage src={image.src} alt="" preset="card" fit="cover" />
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .gallery-section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 8px 16px 40px;
  }
  .gallery-section-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 18px;
  }
  .gallery-section-head h2 {
    margin: 0;
    font-size: 1.25rem;
    color: #183251;
    white-space: nowrap;
  }
  .gallery-section-line {
    flex: 1 1 auto;
    height: 1px;
    background: #e2e8f0;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 900px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .gal-item {
    display: block;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 6px 22px rgba(24, 50, 81, 0.1);
    aspect-ratio: 4 / 3;
    cursor: zoom-in;
  }
  .gal-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .gal-item:hover :global(img) {
    transform: scale(1.06);
  }
</style>
