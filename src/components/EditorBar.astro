---
/**
 * "Edit this page" bar for college staff.
 *
 * Hidden from the public. It appears only in a browser that has opened the
 * CMS (/admin/ sets a flag in localStorage — see public/admin/cms-init.js), or
 * when ?edit is added to any URL. Each link jumps straight to the CMS entry
 * that produces what is on screen, so nobody has to guess which collection
 * or field a piece of the page comes from.
 */
export interface EditLink {
  label: string;
  /** Sveltia CMS hash route, e.g. "collections/news/entries/my-post" */
  route: string;
}

interface Props {
  /** The main thing on this page (the entry or section that renders it). */
  primary?: EditLink;
  /** Extra page-specific shortcuts, e.g. "Add a news post". */
  extra?: EditLink[];
}

const { primary, extra = [] } = Astro.props;

/* Site-wide pieces every page shares. */
const shared: EditLink[] = [
  { label: "Popup announcements", route: "collections/popups" },
  { label: "Main menu", route: "collections/navigation/entries/main_menu" },
  { label: "Footer", route: "collections/footer/entries/footer" },
  { label: "Phone, email & admission button", route: "collections/settings/entries/site" },
];
const href = (r: string) => `/admin/#/${r}`;
---

<div class="eb" data-eb hidden>
  <div class="eb-menu" data-eb-menu hidden>
    {
      extra.length > 0 && (
        <>
          <p class="eb-group">This section</p>
          {extra.map((l) => (
            <a href={href(l.route)} target="ajas-cms">{l.label}</a>
          ))}
        </>
      )
    }
    <p class="eb-group">On every page</p>
    {shared.map((l) => <a href={href(l.route)} target="ajas-cms">{l.label}</a>)}
    <p class="eb-group">Other</p>
    <a href="/admin/" target="ajas-cms">Open the CMS dashboard</a>
    <a href="?popup=preview">Preview popups on this page</a>
    <button type="button" data-eb-hide>Hide this bar on this browser</button>
  </div>
  <div class="eb-bar">
    {/* Edit right here: text and photos on the page itself (inline-editor.js). */}
    <button type="button" class="eb-main" data-eb-inline>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4zM14 6l4 4" /></svg>
      Edit on this page
    </button>
    <a
      class="eb-cms"
      href={primary ? href(primary.route) : "/admin/"}
      target="ajas-cms"
      title={primary ? `${primary.label} in the CMS` : "Open the CMS"}
    >
      CMS ↗
    </a>
    <button type="button" class="eb-more" data-eb-toggle aria-expanded="false" aria-label="More editing shortcuts">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6" /></svg>
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var bar = document.querySelector("[data-eb]");
    if (!bar) return;
    var KEY = "ajas-cms-editor";
    var on = false;
    try {
      var q = new URLSearchParams(location.search);
      if (q.has("edit")) localStorage.setItem(KEY, "1");
      on = localStorage.getItem(KEY) === "1";
    } catch (e) {}
    if (!on) return;
    bar.hidden = false;
    var menu = bar.querySelector("[data-eb-menu]");
    var toggle = bar.querySelector("[data-eb-toggle]");
    toggle.addEventListener("click", function () {
      menu.hidden = !menu.hidden;
      toggle.setAttribute("aria-expanded", String(!menu.hidden));
    });
    document.addEventListener("click", function (e) {
      if (!bar.contains(e.target)) {
        menu.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
      }
    });
    bar.querySelector("[data-eb-hide]").addEventListener("click", function () {
      try { localStorage.removeItem(KEY); } catch (e) {}
      bar.hidden = true;
    });

    // On-page editor: loaded only on demand, so visitors never download it.
    function loadScript(src) {
      return new Promise(function (resolve, reject) {
        var s = document.createElement("script");
        s.src = src;
        s.onload = resolve;
        s.onerror = function () { reject(new Error("Could not load " + src)); };
        document.head.appendChild(s);
      });
    }
    function startInline() {
      var btn = bar.querySelector("[data-eb-inline]");
      btn.disabled = true;
      var chain = window.jsyaml ? Promise.resolve() : loadScript("https://cdnjs.cloudflare.com/ajax/libs/js-yaml/4.1.0/js-yaml.min.js");
      chain
        .then(function () { return window.AjasLive ? null : loadScript("/admin/live-core.js?v=1"); })
        .then(function () { return window.AjasInline ? null : loadScript("/admin/inline-editor.js?v=1"); })
        .then(function () { return window.AjasInline.start(); })
        .then(function () {
          btn.disabled = false;
          if (window.AjasInline.isOn()) bar.hidden = true;
        })
        .catch(function (e) {
          btn.disabled = false;
          alert("The page editor couldn't load: " + e.message);
        });
    }
    bar.querySelector("[data-eb-inline]").addEventListener("click", startInline);
    // Stay in editing mode while moving between pages in this tab.
    try {
      if (sessionStorage.getItem("ajas-inline") === "1") startInline();
    } catch (e) {}
  })();
</script>

<style is:global>
  .eb[hidden],
  .eb-menu[hidden] {
    display: none !important;
  }
  .eb {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 9990;
    font: 500 14px/1.3 "Libre Franklin", system-ui, sans-serif;
  }
  .eb-bar {
    display: flex;
    border-radius: 999px;
    overflow: hidden;
    box-shadow: 0 8px 26px rgba(13, 32, 57, 0.35);
  }
  .eb-main,
  .eb-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #b3242b;
    color: #fff !important;
    border: 0;
    padding: 11px 18px;
    text-decoration: none;
    cursor: pointer;
    font: inherit;
    text-transform: none;
    line-height: 1.3;
    border-radius: 0;
  }
  .eb-cms {
    display: inline-flex;
    align-items: center;
    padding: 11px 14px;
    background: #8f1c22;
    color: #fff !important;
    text-decoration: none;
    border-left: 1px solid rgba(255, 255, 255, 0.3);
  }
  .eb-cms:hover {
    background: #6f151a;
  }
  .eb-main[disabled] {
    opacity: 0.7;
    cursor: progress;
  }
  .eb-more {
    padding: 11px 13px;
    border-left: 1px solid rgba(255, 255, 255, 0.3);
  }
  .eb-main:hover,
  .eb-more:hover {
    background: #8f1c22;
  }
  .eb svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .eb-menu {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 0;
    min-width: 270px;
    max-width: calc(100vw - 32px);
    background: #fff;
    border-radius: 12px;
    padding: 8px;
    box-shadow: 0 14px 40px rgba(13, 32, 57, 0.3);
    display: flex;
    flex-direction: column;
  }
  .eb-menu a,
  .eb-menu button {
    display: block;
    text-align: left;
    padding: 9px 12px;
    border-radius: 8px;
    color: #0d2039 !important;
    text-decoration: none;
    background: none;
    border: 0;
    font: inherit;
    cursor: pointer;
    text-transform: none;
    line-height: 1.3;
  }
  .eb-menu a:hover,
  .eb-menu button:hover {
    background: #f1f4f9;
  }
  .eb-menu button {
    color: #6b7a90 !important;
  }
  .eb-group {
    margin: 8px 12px 2px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8b99ac;
  }
  @media print {
    .eb {
      display: none !important;
    }
  }
</style>
