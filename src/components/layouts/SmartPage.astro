---
/**
 * Content-aware page layout.
 *
 * Two ideas carry every page here:
 *
 * 1. ONE measure. The body is a centred content column (~840px) inside a
 *    "breakout" grid, so prose keeps a readable line length while tables,
 *    galleries and card grids can step out to the full container. The old
 *    layout parked a 190px nav rail on the left and capped the prose at 82ch,
 *    which left a dead strip of several hundred pixels down the right of every
 *    department page.
 * 2. Sections are CLASSIFIED, not dumped. A section that is a list of long
 *    rules renders as a numbered ledger; short parallel items render as a
 *    checklist; a list of links renders as a document index; everything else
 *    is prose. That is what keeps a page like /code-of-cunduct-student/ from
 *    being a wall of text without hand-authoring a layout per page.
 */
import {
  splitSections,
  parseProgrammes,
  looksLikeAdmission,
  looksLikeVision,
  type ContentSection,
} from "../../lib/parseContent";
import { marked } from "marked";
import { optimizeHtmlImages } from "../../lib/cmsImage";
import CmsImage from "../CmsImage.astro";
import AttachmentList from "../AttachmentList.astro";
import DataTable from "../DataTable.astro";

interface Props {
  title: string;
  body: string;
  permalink: string;
  image?: string;
  gallery?: string[];
  attachments?: { label: string; file: string }[];
}

const { title, body: rawBody, permalink, image, gallery = [], attachments } = Astro.props;

const normalizeHeading = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();

/**
 * The page title already renders in the header band, so a body opening with
 * `# Same Title` printed it twice; remaining H1s are demoted to H2 so the
 * section splitter can see them.
 */
function normalizeBodyHeadings(src: string, pageTitle: string): string {
  let out = src.replace(/^﻿/, "").trimStart();
  const firstH1 = out.match(/^#\s+(.+?)\s*$/m);
  if (firstH1 && out.startsWith("#") && !out.startsWith("##")) {
    const heading = normalizeHeading(firstH1[1]);
    const pt = normalizeHeading(pageTitle);
    if (heading === pt || heading.includes(pt) || pt.includes(heading)) {
      out = out.slice(firstH1[0].length).trimStart();
    }
  }
  return out.replace(/^#\s+(?!#)/gm, "## ");
}

const body = normalizeBodyHeadings(rawBody, title);

const isAdmission = looksLikeAdmission(body);
const isVision = looksLikeVision(body, title, permalink);
const parsed = splitSections(body);
const programmes = isAdmission ? parseProgrammes(body) : null;

let introHtml = parsed.introHtml;
let introFacts = [...parsed.introFacts];
let introTables = [...parsed.introTables];
let sections = [...parsed.sections];
let introImages = [...parsed.introImages];

if (!introHtml && !introFacts.length && !introTables.length && sections.length > 0) {
  const first = sections[0];
  if (first.facts.length >= 2) {
    introFacts = first.facts;
    introTables = first.tables;
    introHtml = first.bodyHtml;
    introImages = [...introImages, ...first.images];
    sections = sections.slice(1);
  }
}

/* Only labels whose value is reliably a short number (a year, a count) belong
   in a stat tile — descriptive facts look broken blown up. */
const statKeys = [
  "year of established",
  "year of establishment",
  "established",
  "no of programs",
  "no. of programs",
  "number of programs",
];
const highlightStats = introFacts.filter((f) => {
  const l = f.label.toLowerCase();
  return statKeys.some((k) => l.includes(k)) && f.value.length <= 20;
});
const statsForStrip = highlightStats.length >= 2 ? highlightStats.slice(0, 4) : [];

/* ——— section classification ——————————————————————————————— */
type Kind = "prose" | "rules" | "steps" | "checklist" | "resources";

const LIST_ONLY = /^\s*<(ul|ol)[\s\S]*<\/(ul|ol)>\s*$/;
const LEADING_P = /^\s*<p>[\s\S]*?<\/p>\s*/;

/**
 * A section counts as a list block even when a sentence or two introduces it —
 * "Research publications … are available below" followed by 13 links is still
 * an index, and insisting on a bare list left those pages as plain prose.
 */
function listBody(html: string): string | null {
  let rest = html || "";
  for (let i = 0; i < 2 && !LIST_ONLY.test(rest); i++) {
    const m = rest.match(LEADING_P);
    if (!m) break;
    rest = rest.slice(m[0].length);
  }
  return LIST_ONLY.test(rest) ? rest : null;
}

function classifyHtml(html: string): Kind {
  const list = listBody(html);
  if (!list) return "prose";

  const items = list.match(/<li>([\s\S]*?)<\/li>/g) || [];
  if (items.length < 3) return "prose";

  const texts = items.map((i) => i.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim());
  const linked = items.filter((i) => /<a\s/i.test(i)).length;
  const avg = texts.reduce((a, t) => a + t.length, 0) / texts.length;

  // A list where nearly every row is a link is an index of documents.
  if (linked >= items.length * 0.75 && items.length >= 5) return "resources";
  // Sentence-length items are rules/obligations — number them, one per row.
  if (avg > 85) return "rules";
  // An explicit <ol> of medium-length items reads as a sequence.
  if (list.trimStart().startsWith("<ol") && avg > 40) return "steps";
  // Short parallel items scan best as a two-column checklist.
  if (items.length >= 4) return "checklist";
  return "prose";
}

const classify = (s: ContentSection): Kind => classifyHtml(s.bodyHtml || "");

/* Optimize inline images in HTML fragments */
introHtml = introHtml ? await optimizeHtmlImages(introHtml, "inline") : introHtml;
sections = await Promise.all(
  sections.map(async (s) => ({
    ...s,
    bodyHtml: s.bodyHtml ? await optimizeHtmlImages(s.bodyHtml, "inline") : s.bodyHtml,
  })),
);

const prepared = sections.map((s) => ({ section: s, kind: classify(s) }));

/* The intro gets the same treatment. A page whose entire body is one list —
   Core Values, Recognitions — otherwise rendered as a bare stack of six words
   in a narrow column with the rest of the page empty. */
const introKind = classifyHtml(introHtml || "");
/* The rail needs a label. "Overview" for a page that goes on to have sections;
   the page's own name when the intro *is* the page. */
const introLabel = sections.length > 0 ? "Overview" : "About";

/* Fact rows come from markdown table cells, so a cell like "[View](x.pdf)"
   has to be rendered as markdown, not printed as source. */
const inline = (v: string) => (v ? (marked.parseInline(v, { async: false }) as string) : "");

const progLead = programmes?.leadHtml
  ? await optimizeHtmlImages(programmes.leadHtml, "inline")
  : programmes?.leadHtml;
const progTail = programmes?.tailHtml
  ? await optimizeHtmlImages(programmes.tailHtml, "inline")
  : programmes?.tailHtml;

const hasIntro = !!(introHtml || introFacts.length > 0 || introTables.length > 0);
const showSubnav = sections.length > 1;
const hasDocument =
  hasIntro || sections.length > 0 || !!(attachments && attachments.length > 0);
---

<div class="smart-page">
  {/* ——— Vision & Mission: one composed institutional statement ——— */}
  {
    isVision && (
      <div class="sp-vision">
        <p class="sp-vision-intro">
          The principles that guide learning, leadership and service at Al Jamia.
        </p>
        <div class="sp-vision-grid">
          {parsed.sections.map((s, i) => {
            const imgSrc =
              s.images[0] ||
              gallery[i] ||
              (i === 0 ? image || parsed.introImages[0] : undefined) ||
              (i === 1 ? parsed.introImages[1] : undefined);
            return (
              <section class={`sp-vision-statement ${i % 2 === 1 ? "sp-vision-statement-b" : ""}`} id={s.id}>
                <span class="sp-vision-index" aria-hidden="true">
                  0{i + 1}
                </span>
                {imgSrc ? (
                  <figure class="sp-vision-figure">
                    <CmsImage src={imgSrc} alt={s.title} preset="inline" fit="contain" />
                  </figure>
                ) : (
                  <span class="sp-vision-symbol">
                    <i class={`fa ${i % 2 === 1 ? "fa-bullseye" : "fa-eye"}`} aria-hidden="true" />
                  </span>
                )}
                <div class="sp-vision-copy">
                  <h2>{s.title}</h2>
                  <div class="sp-html" set:html={s.bodyHtml} />
                </div>
              </section>
            );
          })}
        </div>
      </div>
    )
  }

  {/* ——— Admission: programme cards ——— */}
  {
    isAdmission && programmes && (
      <div class="sp-admission">
        {progLead && <div class="sp-lead sp-html" set:html={progLead} />}
        <div class="sp-prog-grid">
          {programmes.programmes.map((p) => (
            <article class="sp-prog-card">
              <h3>{p.title}</h3>
              <ul class="sp-prog-meta">
                {p.duration && (
                  <li>
                    <span>Duration</span>
                    <strong>{p.duration}</strong>
                  </li>
                )}
                {p.fee && (
                  <li>
                    <span>Fee</span>
                    <strong>{p.fee}</strong>
                  </li>
                )}
                {p.intake && (
                  <li>
                    <span>Intake</span>
                    <strong>{p.intake}</strong>
                  </li>
                )}
              </ul>
              {p.complementary && (
                <p class="sp-prog-comp">
                  <em>Complementary:</em> {p.complementary}
                </p>
              )}
              {p.eligibility && (
                <div class="sp-prog-elig">
                  <strong>Eligibility</strong>
                  <p>{p.eligibility}</p>
                </div>
              )}
              {p.extraHtml && <div class="sp-html" set:html={p.extraHtml} />}
            </article>
          ))}
        </div>
        {progTail && <div class="sp-tail sp-html" set:html={progTail} />}
      </div>
    )
  }

  {/* ——— Default: one centred document with breakout blocks ——— */}
  {
    !isVision && !isAdmission && (
      <div class="sp-default">
        {(image || introImages[0]) && (
          <figure class="sp-banner">
            <CmsImage
              src={image || introImages[0]}
              alt=""
              preset="hero"
              fit="cover"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        )}

        {showSubnav && (
          <nav class="sp-subnav widget-toc" aria-label="On this page">
            <span class="sp-subnav-label">On this page</span>
            <ul class="toc-wrap">
              {hasIntro && (
                <li>
                  <a href="#sp-top">Overview</a>
                </li>
              )}
              {sections.map((s) => (
                <li>
                  <a href={`#${s.id}`}>{s.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        {hasDocument && (
          <div class="sp-main-col">
            {statsForStrip.length > 0 && (
              <div class="sp-stats sp-wide">
                {statsForStrip.map((s) => (
                  <div class="sp-stat">
                    <span class="sp-stat-val">{s.value}</span>
                    <span class="sp-stat-lbl">{s.label}</span>
                  </div>
                ))}
              </div>
            )}

            {hasIntro && (
              <section class="sp-section sp-intro-section ajas-prose" id="sp-top">
                <header class="sp-section-head">
                  <h2>{introLabel}</h2>
                </header>
                {introHtml && (
                  <div
                    class:list={[
                      "sp-lede",
                      introKind !== "prose" && ["sp-body", `sp-body-${introKind}`],
                    ]}
                    set:html={introHtml}
                  />
                )}
                {introFacts.length > 0 && (
                  <dl class="sp-fact-inline">
                    {introFacts.map((r) => (
                      <div class="sp-fact-row">
                        <dt set:html={inline(r.label)} />
                        <dd set:html={inline(r.value)} />
                      </div>
                    ))}
                  </dl>
                )}
              </section>
            )}
            {/* a table is a sibling of the intro, not a child: only direct
                children of the breakout grid can claim the wide track */}
            {introTables.map((t) => (
              <div class="sp-wide sp-block">
                <DataTable table={t} />
              </div>
            ))}

            {prepared.map(({ section: s, kind }) => (
              <section class="sp-section ajas-prose" id={s.id} data-kind={kind}>
                <header class="sp-section-head">
                  <h2>{s.title}</h2>
                </header>
                {s.images.length > 0 && (
                  <div class="sp-section-gallery sp-wide">
                    {s.images.map((src) => (
                      <CmsImage src={src} alt="" preset="inline" fit="contain" />
                    ))}
                  </div>
                )}
                {s.facts.length > 0 && (
                  <dl class="sp-fact-inline">
                    {s.facts.map((r) => (
                      <div class="sp-fact-row">
                        <dt set:html={inline(r.label)} />
                        <dd set:html={inline(r.value)} />
                      </div>
                    ))}
                  </dl>
                )}
                {s.bodyHtml && <div class={`sp-body sp-body-${kind}`} set:html={s.bodyHtml} />}
                {s.tables.map((t) => (
                  <div class="sp-table-wrap">
                    <DataTable table={t} />
                  </div>
                ))}
              </section>
            ))}

            {attachments && attachments.length > 0 && (
              <div class="sp-wide">
                <AttachmentList items={attachments} />
              </div>
            )}
          </div>
        )}
      </div>
    )
  }
</div>

<style is:global>
  /* ============================================================
     SMART PAGE
     ============================================================ */
  .smart-page {
    --sp-content: 1040px;
    --sp-gutter: 40px;
    --sp-ink: #17304f;
    --sp-slate: #55647c;
    --sp-rule: #e4eaf1;
    --sp-accent: #ff5f60;
    --sp-gold: #c9a961;
    background: #fff;
    padding: 0 0 8px;
  }

  /* —— shared HTML inside composed sections —— */
  .sp-html p {
    margin: 0 0 0.95em;
    line-height: 1.75;
    color: #2c3e50;
  }
  .sp-html p:last-child {
    margin-bottom: 0;
  }
  .sp-html ul,
  .sp-html ol {
    margin: 0 0 1em;
    padding-left: 1.25em;
  }
  .sp-html img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1em auto;
    border-radius: 0;
  }
  .sp-html a {
    color: #3f4c99;
    font-weight: 500;
  }

  /* ============================================================
     DEFAULT DOCUMENT
     The content column is a breakout grid: prose sits in `content`,
     wide blocks (tables, galleries, stat strips) step out to `wide`.
     ============================================================ */
  /* The page is a two-column editorial document: section headings live in a
     left rail, their content fills the wide column beside them. A single
     centred 840px measure left 400px of dead margin either side on a large
     display — this uses the width without letting a line of prose run to 140
     characters. */
  .sp-default {
    max-width: 1440px;
    margin: 0 auto;
    padding: 26px clamp(16px, 3.4vw, 56px) 8px;
  }
  .sp-main-col {
    display: block;
  }
  .sp-wide {
    grid-column: 1 / -1;
  }

  /* —— banner —— */
  .sp-banner {
    margin: 0 0 26px;
    width: 100%;
    height: clamp(160px, 20vw, 260px);
    border-radius: 0;
    overflow: hidden;
    background: #0c1e34;
  }
  .sp-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* —— sticky section nav: replaces the old left rail —— */
  .sp-subnav {
    position: sticky;
    top: var(--ajn-bar-h, 66px);
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 26px;
    padding: 9px 0;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--sp-rule);
  }
  .sp-subnav-label {
    flex: none;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #97a5b8;
  }
  .sp-subnav .toc-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    min-width: 0;
  }
  .sp-subnav .toc-wrap::-webkit-scrollbar {
    display: none;
  }
  .sp-subnav .toc-wrap li {
    flex: none;
    border: 0;
    padding: 0;
  }
  .sp-subnav .toc-wrap li a {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 13px;
    border-radius: 0;
    border: 1px solid transparent;
    font-size: 13px;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--sp-slate);
    transition: background 0.16s ease, color 0.16s ease;
  }
  .sp-subnav .toc-wrap li a:hover {
    background: #f1f5fa;
    color: var(--sp-ink);
  }
  .sp-subnav .toc-wrap li.active a {
    background: var(--sp-ink);
    border-color: var(--sp-ink);
    color: #fff;
    font-weight: 500;
  }

  /* —— stats —— */
  .sp-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 28px;
  }
  @media (min-width: 700px) {
    .sp-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .sp-stat {
    background: #f5f8fc;
    border: 1px solid var(--sp-rule);
    border-top: 3px solid var(--sp-ink);
    border-radius: 0;
    padding: 16px 14px;
    text-align: center;
  }
  .sp-stat:nth-child(2) {
    border-top-color: #3f4c99;
  }
  .sp-stat:nth-child(3) {
    border-top-color: #8f2934;
  }
  .sp-stat:nth-child(4) {
    border-top-color: var(--sp-gold);
  }
  .sp-stat-val {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.15;
    color: var(--sp-ink);
    margin-bottom: 5px;
  }
  .sp-stat-lbl {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #7d8ba0;
  }

  /* —— intro lede —— */
  .sp-intro {
    padding-bottom: 6px;
  }
  .sp-lede p:first-child {
    font-size: 1.12rem;
    line-height: 1.68;
    color: #33455e;
  }
  .smart-page .sp-intro h1 {
    border: 0;
    padding: 0;
    font-size: 1.4rem;
    margin: 0 0 0.5em;
    color: var(--sp-ink);
  }
  .smart-page .sp-intro h2,
  .smart-page .sp-section h2 {
    border-top: 0;
    padding-top: 0;
  }
  .sp-intro h1::after,
  .sp-section h2::after {
    content: none !important;
  }

  /* —— section frame —— */
  .sp-section {
    margin-top: 40px;
  }
  .sp-main-col > .sp-section:first-child {
    margin-top: 0;
  }
  /* the rule belongs to the section so it spans rail + body, not just the
     heading column */
  .sp-section {
    padding-top: 22px;
    border-top: 1px solid var(--sp-rule);
  }
  .sp-main-col > .sp-section:first-child {
    border-top-width: 2px;
    border-top-color: var(--sp-ink);
  }
  .sp-section-head {
    margin: 0 0 18px;
  }
  .sp-section h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.42rem, 2vw, 1.9rem);
    line-height: 1.18;
    letter-spacing: -0.015em;
    color: var(--sp-ink);
    font-weight: 600;
  }
  .sp-section > :last-child {
    margin-bottom: 0;
  }
  .sp-block {
    margin-bottom: 1.4em;
  }

  @media (min-width: 1080px) {
    .sp-section {
      display: grid;
      grid-template-columns: minmax(190px, 260px) minmax(0, 1fr);
      column-gap: clamp(32px, 4vw, 64px);
      align-items: start;
    }
    .sp-section > * {
      grid-column: 2;
      min-width: 0;
    }
    .sp-section-head {
      grid-column: 1;
      grid-row: 1 / span 99;
      position: sticky;
      top: calc(var(--ajn-bar-h, 66px) + 74px);
      margin-bottom: 0;
    }
    .sp-section > .sp-wide,
    .sp-section > .sp-table-wrap {
      grid-column: 2;
      width: 100%;
      min-width: 0;
    }
  }
  .sp-table-wrap {
    width: 100%;
    min-width: 0;
    margin: 1.2em 0 1.8em;
  }
  /* Prose fills its column: at this type size the column *is* the measure, and
     stopping the text 300px short of the rule above it looked unfinished. The
     container cap below is what keeps the line from running away on a 2560px
     display. */
  .sp-body-prose,
  .sp-lede {
    max-width: none;
  }

  /* —— fact sheet —— */
  .sp-fact-inline {
    margin: 1.1em 0 1.3em;
    border-top: 1px solid #c6d1de;
    border-bottom: 1px solid #c6d1de;
    padding: 2px 0;
  }
  .sp-fact-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px 20px;
    padding: 11px 0;
    border-bottom: 1px solid #eef2f7;
  }
  .sp-fact-row:last-child {
    border-bottom: 0;
  }
  .sp-fact-row dt {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: #6a7889;
  }
  .sp-fact-row dd {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--sp-ink);
    text-align: right;
  }

  /* —— section images —— */
  .sp-section-gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0 0 1.4em;
    justify-content: center;
  }
  .sp-section-gallery img {
    max-width: min(100%, 360px);
    max-height: 320px;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0;
    background: #f4f6fa;
  }

  /* ============================================================
     SECTION BLOCK TYPES — the reusable smart layouts
     ============================================================ */

  /* rules / obligations / numbered items: authoritative numbered ledger, one row per item */
  .sp-body-rules ul,
  .sp-body-rules ol,
  .sp-body-prose ol,
  .smart-page .sp-body ol {
    list-style: none;
    margin: 0 0 1.6em;
    padding: 0;
    counter-reset: sp-rule;
  }
  .sp-body-rules li,
  .sp-body-prose ol > li,
  .smart-page .sp-body ol > li {
    counter-increment: sp-rule;
    position: relative;
    margin: 0;
    padding: 14px 0 15px 52px;
    border-bottom: 1px solid #edf1f6;
    color: #3a4a61;
    line-height: 1.68;
  }
  .sp-body-rules li:last-child,
  .sp-body-prose ol > li:last-child,
  .smart-page .sp-body ol > li:last-child {
    border-bottom: 0;
  }
