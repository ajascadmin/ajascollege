---
/**
 * Homepage body. Every section renders from `content/home/homepage.json`
 * (CMS collection "home") — no hardcoded copy, images or links live here.
 * Markup/classes are kept identical to the original hand-built homepage so
 * the existing design in migrate.css / stylesheet/*.css still applies.
 */
import type { CollectionEntry } from "astro:content";
import CmsImage from "../CmsImage.astro";
import { getCollection } from "astro:content";
import HomeDispatch from "./HomeDispatch.astro";
import HomeCredentials from "./HomeCredentials.astro";
import HomeCampusLife from "./HomeCampusLife.astro";
import HomePlacement from "./HomePlacement.astro";
import HomeWhy from "./HomeWhy.astro";
import HomeStart from "./HomeStart.astro";
import { optimizeCmsImage } from "../../lib/cmsImage";

interface Props {
  data: CollectionEntry<"home">["data"];
}

const { data } = Astro.props;

/** "Department of Commerce & Management Studies" → "Commerce & Management Studies" */
const programmeEntries = await getCollection("programmes", ({ data }) => !data.draft);
const durationByPermalink = new Map(
  programmeEntries.map((p) => [p.data.permalink.replace(/\/+$/, ""), p.data.duration]),
);
/** "4 Years (FYUGP)" → "4 yrs" — a ledger column, not a sentence */
const durationFor = (url: string) => {
  const d = durationByPermalink.get((url || "").replace(/\/+$/, ""));
  if (!d) return "";
  const m = d.match(/(\d+)\s*year/i);
  return m ? `${m[1]} yrs` : d;
};

const shortDept = (t: string) =>
  t.replace(/^(pg\s+)?department\s+of\s+/i, "").replace(/\s*&\s*/g, " & ");
const {
  hero,
  quick_actions,
  accreditation,
  about,
  metrics,
  chairman_message,
  principal_message,
  programmes,
  gallery,
  benefits,
  testimonials,
  quick_link_cta,
} = data;

// Lightbox anchors must point at the generated /_astro asset, not the raw
// /assets/uploads path — mirrors optimizeHtmlImages()'s href-rewrite for
// markdown-driven pages (see src/lib/cmsImage.ts).
const campusHrefs = await Promise.all(
  gallery.slides.map(async (slide) => (await optimizeCmsImage(slide.image, "inline"))?.src || slide.image),
);
const eventHrefs = await Promise.all(
  (gallery.events_slides || []).map(
    async (slide) => (await optimizeCmsImage(slide.image, "inline"))?.src || slide.image,
  ),
);
---

{/* The home page shipped without an <h1>. The hero is a silent video, so the
    heading is set for crawlers and screen readers rather than shown twice. */}
<h1 class="ajas-sr-only">
  Al Jamia Arts &amp; Science College, Perinthalmanna — affiliated to the University of Calicut
</h1>

<section class="ajas-hero ajas-hero--video-only" aria-label="Campus video">
  <div class="hero-media">
    <video class="hero-video" autoplay muted loop playsinline preload="metadata">
      <source src={hero.video} type="video/mp4" />
    </video>
  </div>
</section>

<section class="ajas-actions">
  <div class="container">
    <div class="row">
      {
        quick_actions.map((tile, idx) => (
          <div class="col-lg-4 col-md-4 col-sm-12" data-animate="up" style={`--delay: ${idx * 90}ms`}>
            <a class={`action-tile tile-${tile.style} ${idx === 0 ? "action-tile--featured" : ""}`} href={tile.url}>
              <span class="tile-ico"><i class={`fa fa-${tile.icon}`} aria-hidden="true" /></span>
              <span class="tile-body">
                <span class="tile-head">
                  <span class="tile-title">{tile.title}</span>
                  {idx === 0 && <span class="tile-badge">Open</span>}
                </span>
                <span class="tile-sub">{tile.subtitle}</span>
              </span>
              <span class="tile-cta" aria-label={tile.cta_label}>
                <span class="tile-cta-label">{tile.cta_label}</span>
                <i class="fa fa-arrow-right" aria-hidden="true" />
              </span>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="partner-clients ajas-accred" aria-label="Accreditations and Affiliations">
  <div class="container">
    <div class="accred-head">
      <span class="accred-line" aria-hidden="true"></span>
      <p class="accred-label">{accreditation.label}</p>
      <span class="accred-line" aria-hidden="true"></span>
    </div>
    <div class="accred-rail">
      <ul class="accred-row">
        {
          accreditation.items.map((item, idx) => (
            <li class="accred-card" data-animate="up" style={`--delay: ${idx * 60}ms`}>
              <span class="accred-img-wrap">
                <CmsImage src={item.image} alt={item.name} preset="logo" fit="contain" />
              </span>
              <span class="accred-name">{item.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<section class="ajas-about">
  <div class="container">
    <h2 class="flat-title medium">{about.heading}</h2>
    {about.paragraphs.map((p) => <p>{p}</p>)}
    <a href={about.cta_url} class="btn-box-shadow">{about.cta_label}</a>
  </div>
</section>


<section class="ajas-metric-banner">
  <div class="container">
    <ul class="ajas-metric-row">
      {
        metrics.map((m) => (
          <li>
            <strong>{m.value}</strong>
            <span>{m.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

{/* dated notices and circulars — the page's evidence that the
    institution is active, not a brochure */}
<HomeDispatch />

{/* formal standing, each claim linked to its certificate */}
<HomeCredentials />

<section class="ajas-leadership">
  <div class="container">
    <div
      class="flat-carousel-box clearfix leadership-box"
      data-gap="0" data-column="1" data-column2="1" data-column3="1" data-column4="1"
      data-dots="true" data-auto="true" data-nav="true" data-loop="true"
    >
      <div class="owl-carousel leadership-carousel">
        {
          [chairman_message, principal_message].map((msg) => (
            <div class="leadership-slide">
              <figure class="leadership-photo">
                <a href={msg.photo_url}>
                  <CmsImage src={msg.photo} alt={msg.kicker} preset="poster" fit="cover" />
                </a>
              </figure>
              <div class="leadership-body">
                {/* The person is the subject of the section; "Chairman's
                    message" is the label for it, not the headline. */}
                <p class="leadership-role">{msg.heading}</p>
                <h2 class="leadership-heading">{msg.kicker}</h2>
                {"quote" in msg && msg.quote && <p class="leadership-quote">{msg.quote}</p>}
                {"paragraphs" in msg &&
                  msg.paragraphs &&
                  msg.paragraphs.map((t) => <p class="leadership-text">{t}</p>)}
                {"bullet_points" in msg && msg.bullet_points && (
                  <ul class="leadership-points">
                    {msg.bullet_points.map((b) => <li>{b}</li>)}
                  </ul>
                )}
                <a href={msg.cta_url} class="leadership-link">{msg.cta_label} <i class="fa fa-arrow-right" /></a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<section class="online-courses online-courses-style1 ajas-programmes">
  <div class="container">
    <div class="title-section text-center">
      <p class="sub-title lt-sp17">{programmes.kicker}</p>
      <h2 class="flat-title medium">{programmes.heading}</h2>
    </div>
    <p class="listing-intro">{programmes.intro}</p>

    {/* Two ledgers, not two cards of chips. Each row is one programme:
        name, how long it runs, where it goes. The duration comes from the
        programmes collection, matched on permalink, so the homepage cannot
        drift from the programme pages. */}
    <div class="pl">
      {
        [
          { key: "ug", data: programmes.ug, tone: "ug" },
          { key: "pg", data: programmes.pg, tone: "pg" },
        ].map(({ key, data, tone }) => (
          <section class="pl-col" data-tone={tone}>
            <header class="pl-head">
              <div>
                <p class="pl-level">{data.level_tag}</p>
                <h3>{data.title}</h3>
              </div>
              <span class="pl-count">
                <strong>{data.items.length}</strong>
                <span>{key === "ug" ? "degrees" : "masters"}</span>
              </span>
            </header>
            <p class="pl-meta">{data.meta}</p>

            <ul class="pl-list">
              {data.items.map((it) => (
                <li>
                  <a href={it.url}>
                    <span class="pl-name">{it.label}</span>
                    {durationFor(it.url) && <span class="pl-dur">{durationFor(it.url)}</span>}
                    <svg class="pl-arrow" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>

            {key === "pg" && programmes.pg.highlight_text && (
              <p class="pl-note">{programmes.pg.highlight_text}</p>
            )}

            <div class="pl-foot">
              <a class="pl-cta" href={data.cta_primary_url}>{data.cta_primary_label}</a>
              <a class="pl-cta pl-cta-alt" href={data.cta_secondary_url}>{data.cta_secondary_label}</a>
            </div>
          </section>
        ))
      }
    </div>

    {/* A prospectus contents page, not a card grid: an editorial header with
        the count stated, then a numbered index of departments. Each tile is a
        photograph, an index number, the department's name and what it teaches. */}
    <header class="dx2-head">
      <div>
        <p class="dx2-kicker">{programmes.departments_kicker}</p>
        <h2>{programmes.departments_heading}</h2>
      </div>
      <div class="dx2-head-right">
        <span class="dx2-count">
          <strong>{programmes.departments.length}</strong>
          <span>departments</span>
        </span>
        <a class="dx2-all" href={programmes.view_all_url}>
          {programmes.view_all_label}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </header>

    <ol class="dx2-grid">
      {
        programmes.departments.map((dept, i) => (
          <li>
            <a class="dx2-tile" href={dept.url}>
              <span class="dx2-media">
                <CmsImage src={dept.image} alt="" preset="card" fit="cover" loading="lazy" />
                <span class="dx2-veil" aria-hidden="true" />
                <span class="dx2-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              </span>
              <span class="dx2-body">
                <span class="dx2-name">{shortDept(dept.title)}</span>
                {dept.pills && dept.pills.length > 0 && (
                  <span class="dx2-progs">
                    {dept.pills.map((pill) => (
                      <span>{pill}</span>
                    ))}
                  </span>
                )}
                <span class="dx2-go" aria-hidden="true">
                  Department
                  <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

{/* Campus and Events sat as two stacked full-bleed sliders doing the same
    thing twice. One band, two columns: still two carousels, half the height,
    and they now read as a pair rather than a repeat. */}
<section class="gb">
  <div class="gb-inner">
    <div class="gb-grid">
      <div class="gb-col">
        <header class="gb-head">
          <p class="gb-kicker">{gallery.kicker}</p>
          <h2>{gallery.heading}</h2>
          <a href={gallery.cta_url}>{gallery.cta_label}</a>
        </header>
        <div
          class="flat-carousel-box data-effect clearfix"
          data-gap="0" data-column="1" data-column2="1" data-column3="1" data-column4="1"
          data-dots="true" data-auto="true" data-nav="true" data-loop="true"
        >
          <div class="owl-carousel footages-carousel gb-carousel">
            {gallery.slides.map((slide, i) => (
              <div class="gal-slide">
                <a
                  class="gal-item"
                  href={campusHrefs[i]}
                  rel="ajas-home-campus"
                  data-caption={`${slide.title} — ${slide.caption}`}
                  aria-label={`Open image: ${slide.title}`}
                >
                  <CmsImage src={slide.image} alt={slide.title} preset="card" />
                  <div class="gal-caption">
                    <h3 class="gal-title">{slide.title}</h3>
                    <span class="gal-sub">{slide.caption}</span>
                  </div>
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>

      {gallery.events_slides && gallery.events_slides.length > 0 && (
        <div class="gb-col">
          <header class="gb-head">
            <p class="gb-kicker">{gallery.events_kicker}</p>
            <h2>{gallery.events_heading}</h2>
            <a href={gallery.events_cta_url}>{gallery.events_cta_label}</a>
          </header>
          <div
            class="flat-carousel-box data-effect clearfix"
            data-gap="0" data-column="1" data-column2="1" data-column3="1" data-column4="1"
            data-dots="true" data-auto="true" data-nav="true" data-loop="true"
          >
            <div class="owl-carousel footages-carousel gb-carousel gb-carousel-events">
              {gallery.events_slides.map((slide, i) => (
                <div class="gal-slide">
                  <a
                    class="gal-item"
                    href={eventHrefs[i]}
                    rel="ajas-home-events"
                    data-caption={`${slide.title} — ${slide.caption}`}
                    aria-label={`Open image: ${slide.title}`}
                  >
                    <CmsImage src={slide.image} alt={slide.title} preset="card" />
                    <div class="gal-caption">
                      <h3 class="gal-title">{slide.title}</h3>
                      <span class="gal-sub">{slide.caption}</span>
                    </div>
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<HomeCampusLife />

<HomePlacement />

<HomeWhy data={benefits} />

<section class="ajas-testimonials-section">
  <div class="container">
    <div class="title-section text-center">
      <p class="sub-title lt-sp17">{testimonials.kicker}</p>
      <h2 class="flat-title medium">{testimonials.heading}</h2>
    </div>
    <div
      class="flat-carousel-box clearfix testi-box"
      data-gap="0" data-column="1" data-column2="1" data-column3="1" data-column4="1"
      data-dots="true" data-auto="true" data-nav="false" data-loop="true"
    >
      <div class="owl-carousel testi-carousel">
        {
          testimonials.items.map((t) => (
            <figure class="testi-item">
              <blockquote class="testi-quote">{t.quote}</blockquote>
              <figcaption class="testi-by">
                <CmsImage src={t.photo} alt={t.name} preset="avatar" fit="cover" />
                <span class="testi-meta">
                  <span class="testi-name">{t.name}</span>
                  <span class="testi-role">{t.role}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<HomeStart data={quick_link_cta} />

<script is:inline>
  /* Owl clones each slide and parks the copies thousands of pixels off-screen,
     where a `loading="lazy"` <img> never intersects the viewport — so a looping
     carousel (leadership, campus, events, testimonials) rotates a blank grey
     frame into view. Once the page is idle, let every carousel image fetch. */
  (function () {
    function warmCarouselImages() {
      document.querySelectorAll('.owl-carousel img[loading="lazy"]').forEach(function (img) {
        img.loading = "eager";
        if (!img.complete) img.src = img.src;
      });
    }
    var done = false;
    function once() {
      if (done) return;
      done = true;
      warmCarouselImages();
    }
    window.addEventListener("load", once);
    if ("requestIdleCallback" in window) requestIdleCallback(once, { timeout: 1500 });
    else setTimeout(once, 1500);
  })();
</script>
