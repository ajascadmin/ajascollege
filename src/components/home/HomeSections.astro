---
/**
 * Homepage body. Every section renders from `content/home/homepage.json`
 * (CMS collection "home") — no hardcoded copy, images or links live here.
 * Markup/classes are kept identical to the original hand-built homepage so
 * the existing design in migrate.css / stylesheet/*.css still applies.
 */
import type { CollectionEntry } from "astro:content";
import CmsImage from "../CmsImage.astro";
import { optimizeCmsImage } from "../../lib/cmsImage";

interface Props {
  data: CollectionEntry<"home">["data"];
}

const { data } = Astro.props;
const {
  hero,
  quick_actions,
  accreditation,
  about,
  metrics,
  chairman_message,
  principal_message,
  programmes,
  gallery,
  services,
  benefits,
  events,
  testimonials,
  quick_link_cta,
} = data;

const eventColors = ["7ecc88", "3f4c99", "ff5f60"];

// Lightbox anchors must point at the generated /_astro asset, not the raw
// /assets/uploads path — mirrors optimizeHtmlImages()'s href-rewrite for
// markdown-driven pages (see src/lib/cmsImage.ts).
const gallerySlideHrefs = await Promise.all(
  gallery.slides.map(async (slide) => (await optimizeCmsImage(slide.image, "inline"))?.src || slide.image),
);
---

<section class="ajas-hero ajas-hero--video-only" aria-label="Campus video">
  <div class="hero-media">
    <video class="hero-video" autoplay muted loop playsinline preload="metadata">
      <source src={hero.video} type="video/mp4" />
    </video>
  </div>
</section>

<section class="ajas-actions">
  <div class="container">
    <div class="row">
      {
        quick_actions.map((tile) => (
          <div class="col-lg-4 col-md-4 col-sm-12">
            <a class={`action-tile tile-${tile.style}`} href={tile.url}>
              <span class="tile-ico"><i class={`fa fa-${tile.icon}`} aria-hidden="true" /></span>
              <span class="tile-body">
                <span class="tile-title">{tile.title}</span>
                <span class="tile-sub">{tile.subtitle}</span>
              </span>
              <span class="tile-cta">
                {tile.cta_label} <i class="fa fa-long-arrow-right" aria-hidden="true" />
              </span>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="partner-clients ajas-accred">
  <div class="container">
    <p class="accred-label">{accreditation.label}</p>
    <ul class="accred-row">
      {
        accreditation.items.map((item) => (
          <li>
            <CmsImage src={item.image} alt={item.name} preset="logo" fit="contain" />
            <span>{item.name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="ajas-about">
  <div class="container">
    <h2 class="flat-title medium">{about.heading}</h2>
    {about.paragraphs.map((p) => <p>{p}</p>)}
    <a href={about.cta_url} class="btn-box-shadow">{about.cta_label}</a>
  </div>
</section>

<section class="ajas-metric-banner">
  <div class="container">
    <ul class="ajas-metric-row">
      {
        metrics.map((m) => (
          <li>
            <strong>{m.value}</strong>
            <span>{m.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="flat-introduce flat-introduce-style1 clearfix">
  <div class="container">
    <div class="col-left">
      <div class="videobox">
        <a href={chairman_message.photo_url}>
          <CmsImage src={chairman_message.photo} alt={chairman_message.kicker} preset="poster" />
        </a>
      </div>
    </div>
    <div class="col-right">
      <div class="content-introduce content-introduce-style1">
        <div class="title-section">
          <p class="sub-title lt-sp25">{chairman_message.kicker}</p>
          <div class="flat-title larger heading-type1">{chairman_message.heading}</div>
        </div>
        <div class="content-introduce-inner">
          {chairman_message.paragraphs.map((p) => <p>{p}</p>)}
          <div class="btn-about">
            <a href={chairman_message.cta_url} class="btn-box-shadow">{chairman_message.cta_label}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="flat-introduce flat-introduce-style1 clearfix">
  <div class="container">
    <div class="col-left">
      <div class="videobox">
        <a href={principal_message.photo_url}>
          <CmsImage src={principal_message.photo} alt={principal_message.kicker} preset="poster" />
        </a>
      </div>
    </div>
    <div class="col-right">
      <div class="content-introduce content-introduce-style1">
        <div class="title-section">
          <p class="sub-title lt-sp25">{principal_message.kicker}</p>
          <div class="flat-title larger heading-type1">{principal_message.heading}</div>
        </div>
        <div class="content-introduce-inner">
          <p>{principal_message.quote}</p>
          <div class="content-list">
            <ul>
              {principal_message.bullet_points.map((b) => (
                <li><span class="text">{b}</span></li>
              ))}
            </ul>
          </div>
          <div class="btn-about">
            <a href={principal_message.cta_url} class="btn-box-shadow">{principal_message.cta_label}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="online-courses online-courses-style1 ajas-programmes">
  <div class="container">
    <div class="title-section text-center">
      <p class="sub-title lt-sp17">{programmes.kicker}</p>
      <h2 class="flat-title medium">{programmes.heading}</h2>
    </div>
    <p class="listing-intro">{programmes.intro}</p>

    <div class="row ajas-prog-grid">
      <div class="col-lg-6 col-md-12">
        <div class="ajas-prog-card ug-card">
          <div class="prog-card-header">
            <div class="prog-icon-badge"><i class={`fa fa-${programmes.ug.icon}`} aria-hidden="true" /></div>
            <div class="prog-header-text">
              <span class="prog-level-tag">{programmes.ug.level_tag}</span>
              <h3 class="prog-card-title">{programmes.ug.title}</h3>
              <span class="prog-meta">{programmes.ug.meta}</span>
            </div>
          </div>
          <div class="prog-card-body">
            <ul class="prog-chips-grid">
              {programmes.ug.items.map((it) => (
                <li>
                  <a href={it.url} class="prog-chip">
                    <i class={`fa fa-${it.icon || "check-circle"}`} />
                    {" "}{it.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="prog-card-footer">
            <a href={programmes.ug.cta_primary_url} class="btn-prog-cta">
              {programmes.ug.cta_primary_label} <i class="fa fa-arrow-right" />
            </a>
            <a href={programmes.ug.cta_secondary_url} class="btn-prog-alt">{programmes.ug.cta_secondary_label}</a>
          </div>
        </div>
      </div>

      <div class="col-lg-6 col-md-12">
        <div class="ajas-prog-card pg-card">
          <div class="prog-card-header">
            <div class="prog-icon-badge"><i class={`fa fa-${programmes.pg.icon}`} aria-hidden="true" /></div>
            <div class="prog-header-text">
              <span class="prog-level-tag">{programmes.pg.level_tag}</span>
              <h3 class="prog-card-title">{programmes.pg.title}</h3>
              <span class="prog-meta">{programmes.pg.meta}</span>
            </div>
          </div>
          <div class="prog-card-body">
            <ul class="prog-chips-grid pg-chips">
              {programmes.pg.items.map((it) => (
                <li>
                  <a href={it.url} class="prog-chip">
                    <i class={`fa fa-${it.icon || "star"}`} />
                    {" "}{it.label}
                  </a>
                </li>
              ))}
            </ul>
            {programmes.pg.highlight_text && (
              <div class="pg-highlight-box">
                <div class="pg-hl-icon"><i class={`fa fa-${programmes.pg.highlight_icon || "lightbulb-o"}`} /></div>
                <p>{programmes.pg.highlight_text}</p>
              </div>
            )}
          </div>
          <div class="prog-card-footer">
            <a href={programmes.pg.cta_primary_url} class="btn-prog-cta">
              {programmes.pg.cta_primary_label} <i class="fa fa-arrow-right" />
            </a>
            <a href={programmes.pg.cta_secondary_url} class="btn-prog-alt">{programmes.pg.cta_secondary_label}</a>
          </div>
        </div>
      </div>
    </div>

    <div class="title-section text-center pd-top60">
      <p class="sub-title lt-sp17">{programmes.departments_kicker}</p>
      <h2 class="flat-title medium">{programmes.departments_heading}</h2>
    </div>

    <div class="flat-courses clearfix">
      <div class="row">
        {
          programmes.departments.map((dept) => (
            <div class="col-lg-4 col-md-6 col-sm-12 course-col">
              <div class="ajas-dept-card">
                <div class="dept-card-media">
                  <CmsImage src={dept.image} alt={dept.title} preset="card" />
                  <span class="dept-card-badge"><i class={`fa fa-${dept.icon}`} /> {dept.badge_label}</span>
                </div>
                <div class="dept-card-content">
                  <h3 class="dept-card-heading"><a href={dept.url}>{dept.title}</a></h3>
                  <p class="dept-card-text">{dept.description}</p>
                  <div class="dept-card-pills">
                    {dept.pills.map((pill) => <span class="dept-pill">{pill}</span>)}
                  </div>
                  <div class="dept-card-bottom">
                    <a href={dept.url} class="dept-link-btn">Explore Department <i class="fa fa-arrow-right" /></a>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
      <div class="text-center pd-top30">
        <a href={programmes.view_all_url} class="btn bg-clff5f60 ajas-apply-btn">{programmes.view_all_label}</a>
      </div>
    </div>
  </div>
</section>

<section class="ajas-media">
  <div class="container">
    <div class="title-section text-center">
      <p class="sub-title lt-sp17">{gallery.kicker}</p>
      <h2 class="flat-title medium">{gallery.heading}</h2>
    </div>
    <div
      class="flat-carousel-box data-effect clearfix"
      data-gap="0"
      data-column="1"
      data-column2="1"
      data-column3="1"
      data-column4="1"
      data-dots="true"
      data-auto="true"
      data-nav="true"
      data-loop="true"
    >
      <div class="owl-carousel footages-carousel">
        {
          gallery.slides.map((slide, i) => (
            <div class="gal-slide">
              <a class="gal-item" href={gallerySlideHrefs[i]} rel="ajas-home-media" title={slide.title}>
                <CmsImage src={slide.image} alt={slide.title} preset="card" />
                <div class="gal-caption">
                  <h3 class="gal-title">{slide.title}</h3>
                  <span class="gal-sub">{slide.caption}</span>
                </div>
              </a>
            </div>
          ))
        }
      </div>
    </div>
    <div class="text-center pd-top30">
      <a href={gallery.cta_url} class="btn bg-clff5f60 ajas-apply-btn">{gallery.cta_label}</a>
    </div>
  </div>
</section>

<section class="flat-services style1 parallax parallax1 clearfix ajas-services">
  <div class="section-overlay" />
  <div class="container-fluid">
    <div class="row">
      {
        services.items.map((svc, i) => (
          <div class="col-lg-4">
            <div
              class="services-content-box themesflat-content-box"
              data-padding={i === 0 ? "0% 30% 0% 0%" : i === 1 ? "0% 15% 0% 16%" : "0% 0% 0% 30.5%"}
              data-mobipadding="0% 0% 0% 0%"
              data-smobipadding="0% 0% 0% 0%"
            >
              <div class="flat-imagebox imagebox-services style1">
                <div class="imagebox-content">
                  <span class="ajas-icon"><i class={`fa fa-${svc.icon}`} aria-hidden="true" /></span>
                  <h5 class={`text-${["one", "two", "three"][i] || "one"} text-white`}>{svc.title}</h5>
                  <p class="text-white">{svc.text}</p>
                  <div class="read-more"><a href={svc.cta_url}>{svc.cta_label}</a></div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="flat-benefit style1 clearfix ajas-benefit">
  <div class="container-fluid">
    <div class="col-benefit-left">
      <div class="wrap-inconbox-benefit">
        <div class="title-section"><div class="flat-title small heading-type2 text-white">{benefits.heading}</div></div>
        <div class="iconbox-benefit iconbox-benefit-style1">
          <div class="row">
            {
              benefits.items.map((b, i) => (
                <div class="col-lg-6 col-md-6 col-sm-6 col-sx-12">
                  <div
                    class="themesflat-content-box"
                    data-padding="0% 4% 0% 0%"
                    data-mobipadding="0% 0% 0% 0%"
                    data-smobipadding="0% 0% 0% 0%"
                  >
                    <div class="iconbox">
                      <div class="iconbox-icon"><span class="ajas-icon"><i class={`fa fa-${b.icon}`} aria-hidden="true" /></span></div>
                      <div class={`iconbox-content img-${["one", "two", "three", "four"][i] || "one"}`}>
                        <h3><a href={b.url}>{b.title}</a></h3>
                        <p>{b.text}</p>
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
    <div class="col-benefit-right">
      <div class="ajas-apply-cta">
        <h2>{benefits.cta_heading}</h2>
        <p>{benefits.cta_text}</p>
        <a href={benefits.cta_primary_url} class="ajas-apply-cta-btn">
          {benefits.cta_primary_label} <i class="fa fa-long-arrow-right" aria-hidden="true" />
        </a>
        <a href={benefits.cta_secondary_url} class="ajas-apply-cta-link">{benefits.cta_secondary_label}</a>
      </div>
    </div>
  </div>
</section>

<section class="flat-event flat-event-style1 clearfix ajas-events">
  <div class="container-fluid">
    <div class="col-left">
      <div
        class="content-event-style1 themesflat-content-box"
        data-padding="13.7% 1.2% 0% 0%"
        data-mobipadding="0% 0% 0% 0%"
        data-smobipadding="0% 0% 0% 0%"
      >
        <div class="title-section"><div class="flat-title larger heading-type3">{events.heading}</div></div>
        <div class="content-event-list">
          {
            events.items.map((ev, i) => {
              const color = eventColors[i % eventColors.length];
              const numberWord = ["one", "two", "three", "four", "five"][i] || "one";
              return (
                <div class="content-event">
                  <div class="entry-info clearfix">
                    <div class="entry-title"><a href={ev.url} class={`cl-${color}`}>{ev.title}</a></div>
                    <div class="entry-meta">
                      <ul>
                        <li class="date clearfix"><span class="icon-event icon-icons8-planner-100" /><span class="detail-event">{ev.date}</span></li>
                        <li class="location clearfix"><span class="icon-event icon-icons8-marker-100" /><span class="detail-event">{ev.location}</span></li>
                      </ul>
                    </div>
                  </div>
                  <div class={`entry-number number-${numberWord}`}><span class={`cl-${color}`}>{i + 1}</span></div>
                </div>
              );
            })
          }
        </div>
        <div class="btn-about pd-top15"><a href={events.cta_url} class="btn-box-shadow">{events.cta_label}</a></div>
      </div>
    </div>
    <div class="col-right">
      <div
        class="images-list themesflat-content-box"
        data-padding="0% 0% 0% 15.1%"
        data-mobipadding="0% 0% 0% 0%"
        data-smobipadding="0% 0% 0% 0%"
      >
        <div class="images-list-1">
          {
            events.items.slice(0, 2).map((ev, i) => (
              <div class="img-event">
                {ev.image && <CmsImage src={ev.image} alt={ev.title} preset="card" />}
                <span class={`number bg-cl${eventColors[i % eventColors.length]}`}>{i + 1}</span>
              </div>
            ))
          }
        </div>
        {
          events.items[2] && (
            <div class="images-list-2">
              <div class="img-event">
                {events.items[2].image && <CmsImage src={events.items[2].image} alt={events.items[2].title} preset="card" />}
                <span class={`number bg-cl${eventColors[2 % eventColors.length]}`}>3</span>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<section class="ajas-testimonials-section">
  <div class="container">
    <div class="title-section text-center">
      <p class="sub-title lt-sp17">{testimonials.kicker}</p>
      <h2 class="flat-title medium">{testimonials.heading}</h2>
    </div>
    <div class="ajas-testi-wrapper">
      <div id="slider-testimonial" class="flexslider ajas-testi-slider">
        <ul class="slides">
          {
            testimonials.items.map((t) => (
              <li>
                <div class="ajas-testi-card">
                  <div class="testi-photo-col">
                    <div class="testi-avatar-frame">
                      <CmsImage src={t.photo} alt={t.name} preset="avatar" />
                    </div>
                  </div>
                  <div class="testi-content-col">
                    <div class="testi-quote-mark"><i class="fa fa-quote-left" aria-hidden="true" /></div>
                    <p class="testi-speech">&ldquo; {t.quote} &rdquo;</p>
                    <div class="testi-author-info">
                      <h4 class="testi-name">{t.name}</h4>
                      <span class="testi-role-badge">{t.role}</span>
                    </div>
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="quick-link quick-link-style1 parallax parallax2 ajas-quicklink">
  <div class="section-overlay" />
  <div class="container">
    <div class="row">
      <div class="col-lg-7">
        <div class="wrap-link-left">
          <div class="caption lt-sp275">{quick_link_cta.kicker}</div>
          <div class="heading-lf lt-sp03">{quick_link_cta.heading}</div>
          <p>{quick_link_cta.text}</p>
          <div class="btn-apply-link">
            <ul>
              <li><a href={quick_link_cta.primary_url} class="btn btn-apply bg-clff5f60">{quick_link_cta.primary_label}</a></li>
              <li><a href={quick_link_cta.secondary_url} class="btn btn-request lt-sp06">{quick_link_cta.secondary_label}</a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="wrap-link-right">
          <div class="heading-rg"><span>{quick_link_cta.quicklinks_heading}</span></div>
          <ul class="info-quick-link">
            {
              quick_link_cta.quicklinks.map((link) => (
                <li>
                  <i class={`fa fa-${link.icon}`} aria-hidden="true" />
                  <a href={link.url} target={link.external ? "_blank" : undefined}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
