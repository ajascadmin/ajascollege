---
/**
 * Homepage notice board. The full list of circulars and mandatory
 * disclosures lives on /notices/. This strip is only the way in.
 */
---

<section class="hd">
  <div class="hd-inner">
    <a class="hd-link" href="/notices/">
      <span class="hd-copy">
        <span class="hd-kicker">Documents</span>
        <span class="hd-title">Notice board &amp; Circulars</span>
      </span>
      <span class="hd-go">
        Open the notice board
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </span>
    </a>
  </div>
</section>

<style>
  .hd {
    background: #fff;
    border-top: 1px solid #eef2f7;
  }
  .hd-inner {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 40px);
  }
  .hd-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid #eef2f7;
  }
  .hd-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .hd-kicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8b99ac;
  }
  .hd-title {
    font-family: var(--font-serif);
    font-size: 1.28rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #17304f;
  }
  .hd-go {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ff5f60;
  }
  .hd-go svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hd-link:hover .hd-go {
    color: #17304f;
  }
  .hd-link:hover .hd-go svg {
    transform: translateX(4px);
  }
  @media (max-width: 639px) {
    .hd-link {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
      padding: 18px 0;
    }
    .hd-title {
      font-size: 1.15rem;
    }
  }
</style>
