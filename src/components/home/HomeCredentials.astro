---
/**
 * The trust block: the institution's formal standing, stated plainly with
 * links to the documents that prove it. Accreditation logos alone assert
 * credibility; naming the recognition, the grade and the certificate is what
 * a parent or a regulator actually checks.
 *
 * Every row links to a real PDF already published in /assets/uploads/.
 */
interface Props {
  data?: {
    kicker: string;
    heading: string;
    intro: string;
    cta_label: string;
    cta_url: string;
    items: { label: string; value: string; note?: string; document?: string; link?: string }[];
  };
}
/* Content: homepage.json → credentials (CMS: Homepage → Recognitions on record). */
const data = Astro.props.data;
const facts = (data?.items ?? []).map((f) => ({
  label: f.label,
  value: f.value,
  note: f.note ?? "",
  href: f.document || f.link,
  external: !f.document && !!f.link && /^https?:/i.test(f.link),
}));
---

<section class="hc">
  <div class="hc-inner">
    <header class="hc-head">
      <p class="hc-kicker">{data?.kicker}</p>
      <h2>{data?.heading}</h2>
      <p class="hc-lede">{data?.intro}</p>
      <a class="hc-cta" href={data?.cta_url}>
        {data?.cta_label}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </header>

    <ul class="hc-grid">
      {
        facts.map((f) => {
          const Tag = f.href ? "a" : "div";
          return (
            <li>
              <Tag
                class="hc-item"
                {...(f.href
                  ? {
                      href: f.href,
                      ...(f.external || f.href.endsWith(".pdf")
                        ? { target: "_blank", rel: "noopener" }
                        : {}),
                    }
                  : {})}
              >
                <span class="hc-label">{f.label}</span>
                <span class="hc-value">{f.value}</span>
                <span class="hc-note">{f.note}</span>
                {f.href && (
                  <span class="hc-doc">
                    {f.external ? "Visit site ↗" : "View certificate ↗"}
                  </span>
                )}
              </Tag>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .hc {
    background: #0d2039;
    color: rgba(255, 255, 255, 0.72);
    padding: 58px 0 60px;
  }
  .hc-inner {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 40px);
    display: grid;
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
  }
  @media (min-width: 1024px) {
    .hc-inner {
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    }
  }
  .hc-kicker {
    margin: 0 0 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #c9a961;
  }
  .hc-head h2 {
    margin: 0 0 14px;
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 2.6vw, 2.4rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .hc-lede {
    margin: 0;
    max-width: 46ch;
    font-size: 1rem;
    line-height: 1.72;
    color: rgba(255, 255, 255, 0.66);
  }
  .hc-cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 20px;
    padding-bottom: 5px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    font-size: 13.5px;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
  }
  .hc-cta svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }
  .hc-cta:hover {
    border-bottom-color: #ff5f60;
  }
  .hc-cta:hover svg {
    transform: translateX(4px);
  }

  .hc-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.12);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 1280px) {
    .hc-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .hc-item {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 5px;
    padding: 18px 18px 16px;
    background: #0d2039;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }
  a.hc-item:hover {
    background: #13294a;
    transform: translateY(-2px);
  }
  .hc-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }
  .hc-value {
    font-family: var(--font-serif);
    font-size: 1.24rem;
    font-weight: 600;
    line-height: 1.2;
    color: #fff;
  }
  .hc-note {
    font-size: 12.5px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.58);
  }
  .hc-doc {
    margin-top: auto;
    padding-top: 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: #c9a961;
    transition: color 0.2s ease;
  }
  a.hc-item:hover .hc-doc {
    color: #ffbe34;
  }

  @media (max-width: 639px) {
    .hc {
      padding: 36px 0 38px;
    }
    .hc-item {
      padding: 14px 14px 13px;
    }
    .hc-value {
      font-size: 1.1rem;
    }
  }
</style>
