---
/**
 * News / event detail — optimized poster + body images (Astro Image / getImage).
 */
import CmsImage from "./CmsImage.astro";
import VideoSection from "./VideoSection.astro";
import { optimizeHtmlImages } from "../lib/cmsImage";

interface Props {
  kind: "news" | "event" | "page";
  title: string;
  date?: Date | string;
  image?: string;
  backHref: string;
  backLabel: string;
  /** Pre-rendered HTML body (already markdown-parsed). Will optimize <img> tags. */
  bodyHtml?: string;
  videos?: { file?: string; url?: string; caption?: string }[];
}

const { kind, title, date, image, backHref, backLabel, bodyHtml = "", videos = [] } = Astro.props;

const dateObj = date ? new Date(date) : null;
const dateLabel =
  dateObj && !Number.isNaN(+dateObj)
    ? dateObj.toLocaleDateString("en-IN", {
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric",
      })
    : null;

const kindLabel = kind === "news" ? "News" : kind === "event" ? "Event" : "Page";
const optimizedBody = bodyHtml ? await optimizeHtmlImages(bodyHtml, "poster") : "";
---

<article class="ajas-entity" data-kind={kind}>
  <div class="ajas-entity-card">
    {
      image && (
        <figure class="ajas-entity-poster">
          <CmsImage src={image} alt={title} preset="poster" fit="contain" loading="eager" />
        </figure>
      )
    }

    <div class="ajas-entity-panel">
      <div class="ajas-entity-meta">
        <span class="ajas-entity-kind">{kindLabel}</span>
        {dateLabel && <time datetime={dateObj!.toISOString()}>{dateLabel}</time>}
      </div>
      <h1 class="ajas-entity-title">{title}</h1>
      <div class="ajas-entity-body ajas-prose">
        {optimizedBody ? <Fragment set:html={optimizedBody} /> : <slot />}
      </div>
      {videos && videos.length > 0 && <VideoSection videos={videos} />}
      <footer class="ajas-entity-foot">
        <a class="ajas-entity-back" href={backHref}>← {backLabel}</a>
        <div class="ajas-entity-more">
          <a href="/admission/">Admissions</a>
          <a href="/contact/">Contact</a>
        </div>
      </footer>
    </div>
  </div>
</article>

<style>
  .ajas-entity {
    padding: 28px 16px 56px;
    background: linear-gradient(180deg, #eef2f7 0%, #f7f9fc 50%, #fff 100%);
  }
  .ajas-entity-card {
    max-width: 920px;
    margin: 0 auto;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 12px 36px rgba(24, 50, 81, 0.1);
    overflow: hidden;
  }
  .ajas-entity-poster {
    margin: 0;
    padding: 20px 20px 0;
    background: #f4f6fa;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ajas-entity-poster :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(72vh, 820px);
    object-fit: contain;
    border-radius: 4px;
  }
  .ajas-entity-panel {
    padding: 28px 24px 32px;
  }
  @media (min-width: 768px) {
    .ajas-entity-panel {
      padding: 32px 40px 40px;
    }
    .ajas-entity-poster {
      padding: 28px 28px 0;
    }
  }
  .ajas-entity-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-bottom: 12px;
    font-size: 13px;
  }
  .ajas-entity-kind {
    display: inline-block;
    background: #183251;
    color: #fff;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .ajas-entity-meta time {
    color: #64748b;
  }
  .ajas-entity-title {
    margin: 0 0 1.15rem;
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    line-height: 1.25;
    color: #183251;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .ajas-entity-body :global(h1:first-child) {
    display: none;
  }
  .ajas-entity-body :global(> p:first-child:has(> img:only-child)) {
    display: none;
  }
  .ajas-entity-body :global(img) {
    max-width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    margin: 1em auto;
    display: block;
  }
  .ajas-entity-foot {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid #e8eef4;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    justify-content: space-between;
    align-items: center;
  }
  .ajas-entity-back {
    font-weight: 600;
    color: #3f4c99;
    text-decoration: none;
  }
  .ajas-entity-back:hover {
    color: #ff5f60;
  }
  .ajas-entity-more {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 14px;
  }
  .ajas-entity-more a {
    color: #64748b;
    text-decoration: none;
  }
  .ajas-entity-more a:hover {
    color: #183251;
  }
</style>
