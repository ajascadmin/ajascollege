---
/**
 * News / event detail — optimized poster + body images (Astro Image / getImage).
 */
import CmsImage from "./CmsImage.astro";
import VideoSection from "./VideoSection.astro";
import { optimizeHtmlImages } from "../lib/cmsImage";

interface Props {
  kind: "news" | "event" | "page";
  title: string;
  date?: Date | string;
  image?: string;
  backHref: string;
  backLabel: string;
  /** Pre-rendered HTML body (already markdown-parsed). Will optimize <img> tags. */
  bodyHtml?: string;
  videos?: { file?: string; url?: string; caption?: string }[];
}

const { kind, title, date, image, backHref, backLabel, bodyHtml = "", videos = [] } = Astro.props;

const dateObj = date ? new Date(date) : null;
const dateLabel =
  dateObj && !Number.isNaN(+dateObj)
    ? dateObj.toLocaleDateString("en-IN", {
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric",
      })
    : null;

const kindLabel = kind === "news" ? "News" : kind === "event" ? "Event" : "Page";
/* Migrated bodies repeat the headline as a leading <h1>. It used to be hidden
   with CSS, which left a second (and with the page band, a third) <h1> in the
   document for crawlers to read. Strip it instead. */
const withoutLeadHeading = bodyHtml.replace(/^\s*<h1[^>]*>[\s\S]*?<\/h1>\s*/i, "");
const optimizedBody = withoutLeadHeading
  ? await optimizeHtmlImages(withoutLeadHeading, "poster")
  : "";
---

<article class="ajas-entity" data-kind={kind}>
  <div class="ajas-entity-layout">
    {
      image && (
        <figure class="ajas-entity-poster">
          <CmsImage src={image} alt={title} preset="poster" fit="contain" loading="eager" />
        </figure>
      )
    }

    <div class="ajas-entity-panel">
      <div class="ajas-entity-meta">
        <span class="ajas-entity-kind">{kindLabel}</span>
        {dateLabel && <time datetime={dateObj!.toISOString()}>{dateLabel}</time>}
      </div>
      <h1 class="ajas-entity-title">{title}</h1>
      <div class="ajas-entity-body ajas-prose">
        {optimizedBody ? <Fragment set:html={optimizedBody} /> : <slot />}
      </div>
      {videos && videos.length > 0 && <VideoSection videos={videos} />}
      <footer class="ajas-entity-foot">
        <a class="ajas-entity-back" href={backHref}>← {backLabel}</a>
        <div class="ajas-entity-more">
          <a href="/admission/">Admissions</a>
          <a href="/contact/">Contact</a>
        </div>
      </footer>
    </div>
  </div>
</article>

<style>
  .ajas-entity {
    padding: 48px 20px 72px;
    background: #fff;
  }
  .ajas-entity-layout {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    gap: 42px;
    align-items: start;
  }
  .ajas-entity-poster {
    margin: 0;
    padding: 0;
    background: #eef2f6;
    display: flex;
    align-items: center;
    justify-content: center;
    border-top: 4px solid #c4a35a;
  }
  .ajas-entity-poster :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(72vh, 820px);
    object-fit: contain;
    border-radius: 0;
  }
  .ajas-entity-panel {
    padding: 0;
  }
  @media (min-width: 900px) {
    .ajas-entity-layout:has(.ajas-entity-poster) {
      grid-template-columns: minmax(360px, .9fr) minmax(0, 1.1fr);
    }
    .ajas-entity-poster { position: sticky; top: 104px; }
  }
  .ajas-entity-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-bottom: 12px;
    font-size: 13px;
  }
  .ajas-entity-kind {
    display: inline-block;
    color: #8f2934;
    font-weight: 600;
    font-size: 13px;
    padding-right: 16px;
    border-right: 1px solid #cfd8e5;
  }
  .ajas-entity-meta time {
    color: #64748b;
  }
  .ajas-entity-title {
    margin: 0 0 1.4rem;
    padding-bottom: 1.15rem;
    border-bottom: 2px solid #183251;
    font-size: clamp(2rem, 4vw, 3.45rem);
    line-height: 1.08;
    color: #183251;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .ajas-entity-body :global(> p:first-child:has(> img:only-child)) {
    display: none;
  }
  .ajas-entity-body :global(img) {
    max-width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 0;
    margin: 1em auto;
    display: block;
  }
  .ajas-entity-foot {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid #e8eef4;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    justify-content: space-between;
    align-items: center;
  }
  @media (max-width: 899px) {
    .ajas-entity { padding-top: 32px; }
    .ajas-entity-layout { gap: 30px; max-width: 760px; }
  }
  .ajas-entity-back {
    font-weight: 600;
    color: #3f4c99;
    text-decoration: none;
  }
  .ajas-entity-back:hover {
    color: #ff5f60;
  }
  .ajas-entity-more {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 14px;
  }
  .ajas-entity-more a {
    color: #17304f;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgba(23, 48, 79, 0.3);
    padding-bottom: 2px;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .ajas-entity-more a:hover {
    color: #ff5f60;
    border-bottom-color: #ff5f60;
  }
</style>
