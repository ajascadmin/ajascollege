---
/**
 * Structured video block — CMS-editable `videos` frontmatter list.
 * Each item is either an uploaded MP4 (`file`) or a YouTube/Vimeo link (`url`).
 */
interface VideoItem {
  file?: string;
  url?: string;
  caption?: string;
}

interface Props {
  videos?: VideoItem[];
  title?: string;
}

const { videos = [], title = "Video" } = Astro.props;

function toEmbedSrc(url: string): string | null {
  try {
    const u = new URL(url);
    if (u.hostname.includes("youtu.be")) {
      return `https://www.youtube-nocookie.com/embed/${u.pathname.slice(1)}`;
    }
    if (u.hostname.includes("youtube.com")) {
      const id = u.searchParams.get("v");
      if (id) return `https://www.youtube-nocookie.com/embed/${id}`;
      if (u.pathname.startsWith("/embed/")) return url;
    }
    if (u.hostname.includes("vimeo.com")) {
      const id = u.pathname.split("/").filter(Boolean).pop();
      if (id) return `https://player.vimeo.com/video/${id}`;
    }
    return null;
  } catch {
    return null;
  }
}

const items = (videos || [])
  .filter((v) => v.file || v.url)
  .map((v) => ({
    ...v,
    embedSrc: v.url ? toEmbedSrc(v.url) : null,
  }));
---

{
  items.length > 0 && (
    <section class="video-section">
      <div class="video-section-head">
        <span class="video-section-line" aria-hidden="true" />
        <h2>{title}</h2>
      </div>
      <div class="video-grid">
        {items.map((v) => (
          <figure class="video-item">
            {v.file ? (
              <video controls preload="metadata" src={v.file} />
            ) : v.embedSrc ? (
              <div class="video-embed">
                <iframe
                  src={v.embedSrc}
                  title={v.caption || "Video"}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              </div>
            ) : (
              <a class="video-fallback" href={v.url} target="_blank" rel="noopener">
                Watch video ↗
              </a>
            )}
            {v.caption && <figcaption>{v.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </section>
  )
}

<style>
  .video-section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 8px 16px 40px;
  }
  .video-section-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 18px;
  }
  .video-section-head h2 {
    margin: 0;
    font-size: 1.25rem;
    color: #183251;
    white-space: nowrap;
  }
  .video-section-line {
    flex: 1 1 auto;
    height: 1px;
    background: #e2e8f0;
  }
  .video-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 720px) {
    .video-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .video-item {
    margin: 0;
    border-radius: 0;
    overflow: hidden;
    box-shadow: 0 6px 22px rgba(24, 50, 81, 0.1);
    background: #0b1320;
  }
  .video-item video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .video-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
  }
  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .video-item figcaption {
    padding: 10px 14px;
    font-size: 0.9rem;
    color: #475569;
    background: #f4f6fa;
  }
</style>
