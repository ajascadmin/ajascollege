---
/**
 * Staff/committee directory — CMS-editable `people` frontmatter list.
 * Replaces the old "![photo](x)\n\n### Name\n\nRole" markdown pattern,
 * which silently dropped every photo but the first when rendered.
 */
import CmsImage from "./CmsImage.astro";

interface Person {
  photo?: string;
  name: string;
  role?: string;
  phone?: string;
  link?: string;
}

interface Props {
  people: Person[];
  title?: string;
}

const { people, title } = Astro.props;
---

{
  people && people.length > 0 && (
    <section class="people-grid-section">
      {title && (
        <div class="people-grid-head">
          <span class="people-grid-line" aria-hidden="true" />
          <h2>{title}</h2>
        </div>
      )}
      <div class="people-grid">
        {people.map((p) => {
          const Tag = p.link ? "a" : "article";
          return (
          <Tag class="people-card" {...(p.link ? { href: p.link } : {})}>
            {p.photo ? (
              <div class="people-card-photo">
                <CmsImage src={p.photo} alt={p.name} preset="avatar" fit="cover" />
              </div>
            ) : (
              <div class="people-card-photo people-card-photo-fallback" aria-hidden="true">
                {p.name
                  .split(/\s+/)
                  .slice(0, 2)
                  .map((w) => w[0])
                  .join("")}
              </div>
            )}
            <div class="people-card-body">
              <h3>{p.name}</h3>
              {p.role && <p class="people-card-role">{p.role}</p>}
              {p.phone && !p.link && (
                <a class="people-card-phone" href={`tel:${p.phone.replace(/\s+/g, "")}`}>
                  {p.phone}
                </a>
              )}
            </div>
          </Tag>
          );
        })}
      </div>
    </section>
  )
}

<style>
  .people-grid-section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 8px 16px 40px;
  }
  .people-grid-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 18px;
  }
  .people-grid-head h2 {
    margin: 0;
    font-size: 1.25rem;
    color: #183251;
    white-space: nowrap;
  }
  .people-grid-line {
    flex: 1 1 auto;
    height: 1px;
    background: #e2e8f0;
  }
  .people-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 18px;
  }
  .people-card {
    background: #fff;
    border-radius: 12px;
    padding: 18px 16px 20px;
    text-align: center;
    box-shadow: 0 8px 26px rgba(24, 50, 81, 0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  a.people-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(24, 50, 81, 0.14);
  }
  .people-card-photo {
    width: 92px;
    height: 92px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 14px;
    background: #f0f3f8;
    flex-shrink: 0;
  }
  .people-card-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  .people-card-photo-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    font-weight: 700;
    color: #7a8aa8;
    background: linear-gradient(160deg, #eef2f9, #e2e8f4);
  }
  .people-card-body h3 {
    margin: 0 0 4px;
    font-size: 0.98rem;
    color: #183251;
    line-height: 1.3;
  }
  .people-card-role {
    margin: 0;
    font-size: 0.82rem;
    color: #5c6578;
    line-height: 1.4;
  }
  .people-card-phone {
    display: inline-block;
    margin-top: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #3f4c99;
    text-decoration: none;
  }
  .people-card-phone:hover {
    color: #ff5f60;
  }
</style>
