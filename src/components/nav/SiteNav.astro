      gap: 6px;
    }
    .ajn-icon-btn {
      width: 40px;
      height: 40px;
      flex-basis: 40px;
      border-radius: 0 !important;
    }
  }
  @media (max-width: 559px) {
    .ajn-search-mob {
      display: none;
    }
  }
  @media (max-width: 430px) {
    :root {
      --ajn-bar-h: 66px;
    }
