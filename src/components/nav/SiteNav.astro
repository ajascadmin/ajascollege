      max-width: 100%;
      object-fit: contain;
      object-position: left center;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .ajn-brand-compact {
      display: none !important;
    }
    .ajn-mast-right {
      gap: 8px;
    }
    .ajn-cta {
      height: 38px;
      padding: 0 16px;
      font-size: 13.5px;
      font-weight: 700;
      border-radius: 0 !important;
      letter-spacing: 0.01em;
    }
