    }
    .ajn-top::after {
      left: 9px;
      right: 9px;
    }
  }
  @media (max-width: 1379px) {
    /* the name would start pushing the nav row off centre — the emblem
       carries the mark on its own from here down */
    .ajn-railmark-full {
      display: none;
    }
    .ajn-railmark .ajn-railmark-mark {
      display: block;
    }
    .ajn-bar.is-stuck .ajn-railmark {
      max-width: 40px;
    }
  }
  @media (max-width: 1279px) {
    .ajn-top {
      font-size: 12.3px;
      padding: 0 6px;
    }
    .ajn-top::after {
      left: 6px;
      right: 6px;
    }
    .ajn-bar-inner {
      gap: 12px;
    }
  }
  /* hand over to the drawer while the bar can still hold its row */
  /* the phone/email pills shed their labels before they crowd the CTA */
  @media (max-width: 1439px) {
    .ajn-mast-contact-text {
      display: none;
    }
    .ajn-mast-contact a {
      width: 36px;
      padding: 0;
      justify-content: center;
    }
    .ajn-mast-right {
      gap: 16px;
    }
  }
  @media (max-width: 1259px) {
    .ajn-mast-inner {
      min-height: 76px;
      padding: 0 24px;
    }
    .ajn-brand img {
      max-height: 40px;
    }
    .ajn-admit-label {
      font-size: 15px;
    }
  }

  /* ---- drawer takes over ---- */
  @media (max-width: 1159px) {
    :root {
      --ajn-bar-h: 56px;
    }
    /* the whole navy rail goes with it — on a phone the drawer IS the nav */
    .ajn-bar {
      display: none;
    }
    .ajn-burger,
    .ajn-search-mob {
      display: inline-flex;
    }
    .ajn-admit,
    .ajn-mast-contact {
      display: none;
    }
    .ajn-admit-strip {
      display: flex;
