  /* ---------- breakpoints ---------- */
  /* Eleven sections still need tightening before the drawer takes over. */
  @media (max-width: 1499px) {
    .ajn-bar-inner,
    .ajn-panel-inner {
      padding-left: 24px;
      padding-right: 24px;
    }
    .ajn-top {
