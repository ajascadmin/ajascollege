      height: 38px;
      flex-basis: 38px;
      border-radius: 0 !important;
    }
  }
  @media (max-width: 360px) {
    :root {
      --ajn-bar-h: 62px;
    }
    .ajn-mast-inner {
      padding: 0 10px;
      min-height: 62px;
      gap: 8px;
    }
    .ajn-brand {
      max-width: calc(100% - 110px);
    }
    .ajn-brand > img,
    .ajn-brand > picture {
      max-height: 36px;
    }
    .ajn-cta {
      height: 34px;
      padding: 0 10px;
      font-size: 12px;
      font-weight: 700;
      border-radius: 0 !important;
    }
    .ajn-burger {
      width: 36px;
      height: 36px;
      flex-basis: 36px;
      border-radius: 0 !important;
    }
  }
  @media (max-width: 419px) {
    /* one clean line beats a two-line wrap in a 34px strip */
    .ajn-admit-strip em {
      display: none;
    }
  }
  body.ajn-locked {
    overflow: hidden;
  }
  /* the floating scroll-top / search widgets must never sit above the drawer */
  body.ajn-locked #scroll-top,
  body.ajn-locked .ajas-search-trigger {
    display: none !important;
  }
  #scroll-top {
    z-index: 930 !important;
  }
  /* the nav now owns search; keep the Pagefind trigger in the DOM (the modal
     machinery binds to it) but out of the way */
  .ajas-search-trigger {
    position: fixed !important;
    left: -9999px !important;
    bottom: 0 !important;
    width: 1px !important;
    height: 1px !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .ajn *,
    .ajn-drawer {
      transition-duration: 0.01ms !important;
    }
