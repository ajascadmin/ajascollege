<script is:inline>
  (function () {
    var root = document.querySelector(".ajn");
    if (!root) return;

    var bar = root.querySelector(".ajn-bar");
    var scrim = root.querySelector(".ajn-scrim");
    var drawer = root.querySelector(".ajn-drawer");
    var burger = root.querySelector(".ajn-burger");
    var closeBtn = root.querySelector(".ajn-drawer-close");
    var desktop = window.matchMedia("(min-width: 1160px)");

    /* ---- sticky bar shadow ---- */
    var onScroll = function () {
      if (!bar) return;
      bar.classList.toggle("is-stuck", window.pageYOffset > 24);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    /* ---- scrim is shared by panels and the drawer ----
       Derived from state, never counted. The counter this replaced was
       incremented on every panel open but only decremented on an *unsilenced*
       close, so moving the pointer across the top-level items left it above
       zero and the page stayed blurred after the drawer closed. */
    var drawerOpen = false;
    function syncScrim() {
      if (!scrim) return;
      var want = drawerOpen || !!openItem;
      if (want) {
        scrim.hidden = false;
        requestAnimationFrame(function () {
          if (drawerOpen || openItem) scrim.classList.add("is-on");
        });
      } else {
        scrim.classList.remove("is-on");
        setTimeout(function () {
          if (!drawerOpen && !openItem) scrim.hidden = true;
        }, 240);
      }
    }

    /* ---- desktop mega panels ---- */
    var items = Array.prototype.slice.call(root.querySelectorAll(".ajn-item.has-panel"));
    var openItem = null;
    var openTimer = null;
    var closeTimer = null;

    function panelOf(li) {
      return li.querySelector(":scope > .ajn-panel");
    }

    function openPanel(li) {
      if (openItem === li) return;
      if (openItem) closePanel(openItem, true);
      var panel = panelOf(li);
      if (!panel) return;
      panel.hidden = false;
      // let the browser register the un-hidden element before transitioning
      requestAnimationFrame(function () {
        li.classList.add("is-open");
      });
      var btn = li.querySelector(":scope > .ajn-top");
      if (btn) btn.setAttribute("aria-expanded", "true");
      openItem = li;
      syncScrim();
    }

    function closePanel(li, silent) {
      if (!li) return;
      var panel = panelOf(li);
      li.classList.remove("is-open");
      var btn = li.querySelector(":scope > .ajn-top");
      if (btn) btn.setAttribute("aria-expanded", "false");
      setTimeout(function () {
        if (panel && !li.classList.contains("is-open")) panel.hidden = true;
      }, 220);
      if (openItem === li) openItem = null;
      if (!silent) syncScrim();
    }

    function closeAll() {
      if (openItem) closePanel(openItem);
    }

    items.forEach(function (li) {
      var btn = li.querySelector(":scope > .ajn-top");

      li.addEventListener("pointerenter", function (e) {
        if (!desktop.matches || e.pointerType === "touch") return;
        clearTimeout(closeTimer);
        clearTimeout(openTimer);
        openTimer = setTimeout(function () {
          openPanel(li);
        }, 70);
      });
      li.addEventListener("pointerleave", function (e) {
        if (!desktop.matches || e.pointerType === "touch") return;
        clearTimeout(openTimer);
        clearTimeout(closeTimer);
        closeTimer = setTimeout(function () {
          closePanel(li);
        }, 180);
      });
      if (btn) {
        btn.addEventListener("click", function (e) {
          if (!desktop.matches) return;
          e.preventDefault();
          if (li.classList.contains("is-open")) closePanel(li);
          else openPanel(li);
        });
      }
      li.addEventListener("focusin", function () {
        if (desktop.matches) openPanel(li);
      });
    });

    root.addEventListener("focusout", function (e) {
      if (!openItem || !desktop.matches) return;
      if (!openItem.contains(e.relatedTarget)) closePanel(openItem);
    });

    /* ---- mobile drawer ---- */
    function openDrawer() {
      if (!drawer) return;
      closeAll();
      drawer.hidden = false;
      requestAnimationFrame(function () {
        drawer.classList.add("is-open");
      });
      if (burger) {
        burger.setAttribute("aria-expanded", "true");
        burger.setAttribute("aria-label", "Close menu");
      }
      document.body.classList.add("ajn-locked");
      drawerOpen = true;
      syncScrim();
      if (closeBtn) closeBtn.focus();
    }

    function closeDrawer() {
      if (!drawer || drawer.hidden) return;
      drawer.classList.remove("is-open");
      if (burger) {
        burger.setAttribute("aria-expanded", "false");
        burger.setAttribute("aria-label", "Open menu");
      }
      document.body.classList.remove("ajn-locked");
      drawerOpen = false;
      syncScrim();
      setTimeout(function () {
        if (!drawer.classList.contains("is-open")) drawer.hidden = true;
      }, 320);
    }

    if (burger) {
      burger.addEventListener("click", function () {
        if (drawer && drawer.classList.contains("is-open")) closeDrawer();
        else openDrawer();
      });
    }
    if (closeBtn) closeBtn.addEventListener("click", closeDrawer);
    if (scrim) {
      scrim.addEventListener("click", function () {
        closeDrawer();
        closeAll();
      });
    }

    /* accordion */
    root.querySelectorAll(".ajn-acc-toggle").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var panel = btn.nextElementSibling;
        if (!panel) return;
        var open = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", open ? "false" : "true");
        panel.hidden = open;
      });
    });

    document.addEventListener("keydown", function (e) {
      if (e.key !== "Escape") return;
      if (drawer && drawer.classList.contains("is-open")) {
        closeDrawer();
        if (burger) burger.focus();
      } else if (openItem) {
        var btn = openItem.querySelector(":scope > .ajn-top");
        closePanel(openItem);
        if (btn) btn.focus();
      }
    });

    desktop.addEventListener("change", function () {
      closeDrawer();
      closeAll();
      drawerOpen = false;
      openItem = null;
      syncScrim();
    });

    // last-resort guard: anything that leaves the scrim on with nothing open
    // (a bfcache restore, a stray class) must not blur the page
    window.addEventListener("pageshow", function () {
      drawerOpen = false;
      openItem = null;
      document.body.classList.remove("ajn-locked");
      if (scrim) {
        scrim.classList.remove("is-on");
        scrim.hidden = true;
      }
    });

    /* ---- search button hands off to the Pagefind modal ---- */
    root.querySelectorAll("[data-ajn-search]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        closeDrawer();
        var modal = document.querySelector("pagefind-modal");
        if (modal && typeof modal.open === "function") {
          modal.open();
          return;
        }
        var trigger = document.querySelector("pagefind-modal-trigger");
        if (trigger) {
          var inner = trigger.shadowRoot && trigger.shadowRoot.querySelector("button");
          (inner || trigger).click();
        }
      });
    });
  })();
</script>
